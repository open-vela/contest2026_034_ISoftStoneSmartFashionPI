<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_034_ISoftStoneSmartFashionPI" name="contest2026_034_ISoftStoneSmartFashionPI">
    <linkfile src="app/hello_app" dest="packages/demos/contest2026_034_hello_app"/>
    <linkfile src="quickapp/hello_quickapp" dest="packages/apps/contest2026_034_hello_quickapp"/>
    <linkfile src="board/contest_board" dest="vendor/openvela/boards/contest2026_034_board"/>
    <!-- Team product: board port, watch apps, voice test examples, vendored ai_agent -->
    <linkfile src="board/esp32s3-touch-amoled" dest="nuttx/boards/xtensa/esp32s3/esp32s3-touch-amoled"/>
    <linkfile src="app_watch" dest="packages/demos/app_watch"/>
    <linkfile src="app/watch" dest="apps/examples/contest2026_034_watch"/>
    <linkfile src="examples/esp32s3_watch_button" dest="apps/examples/esp32s3_watch_button"/>
    <linkfile src="examples/esp32s3_watch_pcf85063" dest="apps/examples/esp32s3_watch_pcf85063"/>
    <linkfile src="examples/esp32s3_watch_qmi8658" dest="apps/examples/esp32s3_watch_qmi8658"/>
    <linkfile src="examples/esp32s3_watch_wifi" dest="apps/examples/esp32s3_watch_wifi"/>
    <linkfile src="examples/mimo_stream_voice_test" dest="apps/examples/mimo_stream_voice_test"/>
    <linkfile src="examples/mimo_voice_test" dest="apps/examples/mimo_voice_test"/>
    <linkfile src="examples/volc_e2e_voice" dest="apps/examples/volc_e2e_voice"/>
    <!-- ai_agent is vendored (contains team voice stack); project removed from openvela.xml -->
    <linkfile src="vendor/ai_agent" dest="packages/ai_agent"/>
  </project>
</manifest>
