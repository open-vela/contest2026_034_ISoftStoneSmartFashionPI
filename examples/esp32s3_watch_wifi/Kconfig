	string "Program name"
	default "esp32s3wifi"	
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.
config EXAMPLES_ESP32S3_WATCH_WIFI_PRIORITY
	int "ESP32S3 WATCH WIFI task priority"
	default 100
config EXAMPLES_ESP32S3_WATCH_WIFI_STACKSIZE
	int "ESP32S3 WATCH WIFI stack size"	
	default DEFAULT_TASK_STACKSIZE
endif
