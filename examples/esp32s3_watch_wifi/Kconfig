config EXAMPLES_ESP32S3_WATCH_WIFI
	tristate "ESP32S3 WATCH WIFI Example"
	default n
	---help---
		ESP32S3 watch wifi example
if EXAMPLES_ESP32S3_WATCH_WIFI
