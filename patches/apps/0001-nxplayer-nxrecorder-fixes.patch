@@ -1807,6 +2093,7 @@ int nxplayer_setdevice(FAR struct nxplayer_s *pplayer,
 int nxplayer_stop(FAR struct nxplayer_s *pplayer)
 {
   struct audio_msg_s term_msg;
+  int id = 0;
 
   DEBUGASSERT(pplayer != NULL);
 
@@ -1819,18 +2106,60 @@ int nxplayer_stop(FAR struct nxplayer_s *pplayer)
       return OK;
     }
 
+  /* Set state to IDLE so the playthread can detect stop via timeout */
+
+  pplayer->state = NXPLAYER_STATE_IDLE;
