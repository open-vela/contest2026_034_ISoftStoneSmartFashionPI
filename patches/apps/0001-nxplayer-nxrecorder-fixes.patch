   /* Notify the playback thread that it needs to cancel the playback */
 
   term_msg.msg_id = AUDIO_MSG_STOP;
   term_msg.u.data = 0;
-  mq_send(pplayer->mq, (FAR const char *)&term_msg, sizeof(term_msg),
-          CONFIG_NXPLAYER_MSG_PRIO);
 
-  /* Join the thread.  The thread will do all the cleanup. */
+  {
+    struct mq_attr attr;
+    struct mq_attr old_attr;
+
+    if (mq_getattr(pplayer->mq, &attr) == 0)
+      {
+        old_attr.mq_flags = attr.mq_flags;
+        attr.mq_flags |= O_NONBLOCK;
+        mq_setattr(pplayer->mq, &attr, NULL);
+        mq_send(pplayer->mq, (FAR const char *)&term_msg,
+                sizeof(term_msg), CONFIG_NXPLAYER_MSG_PRIO);
+        mq_setattr(pplayer->mq, &old_attr, NULL);
+      }
+    else
+      {
+        mq_send(pplayer->mq, (FAR const char *)&term_msg,
+                sizeof(term_msg), CONFIG_NXPLAYER_MSG_PRIO);
+      }
+  }
 
-  nxplayer_jointhread(pplayer);
+  /* Join the playthread to ensure it finishes cleanup (UNREGISTERMQ,
+   * RELEASE, close dev_fd, etc.) before we return. Without this, if the
+   * user quits nxplayer before the detached playthread finishes, the
+   * process exit kills the playthread and leaves the audio device in an
