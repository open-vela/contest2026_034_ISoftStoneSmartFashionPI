-/****************************************************************************
+/**************************************************************************** 
  * Private Functions
  ****************************************************************************/
 
+/**************************************************************************** 
+ * Name: nxplayer_parse_wav
+ *
+ *   Parse WAV file header to get audio parameters.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_AUDIO_FORMAT_PCM
+
+/* Read a little-endian value from a byte buffer, avoiding any alignment
+ * assumptions.  WAV files are always little-endian.
+ */
+
+static inline uint16_t get_le16(FAR const uint8_t *p)
+{
+  return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
+}
+
+static inline uint32_t get_le32(FAR const uint8_t *p)
+{
+  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+         ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static int nxplayer_parse_wav(int fd, FAR uint32_t *samplerate,
+                              FAR uint8_t *chans, FAR uint8_t *bps)
+{
+  uint8_t  buf[16];
+  bool     have_fmt  = false;
+  bool     have_data = false;
+  int      ret;
+
+  /* Read and validate the 12-byte RIFF header: "RIFF" <size> "WAVE" */
+
+  lseek(fd, 0, SEEK_SET);
+  ret = read(fd, buf, 12);
+  if (ret < 12)
+    {
+      return -EIO;
+    }
+
+  if (buf[0] != 'R' || buf[1] != 'I' || buf[2] != 'F' || buf[3] != 'F' ||
+      buf[8] != 'W' || buf[9] != 'A' || buf[10] != 'V' || buf[11] != 'E')
+    {
+      return -EINVAL;
+    }
+
+  /* Scan the chunks that follow the RIFF/WAVE header (starting at offset
+   * 12).  Each chunk begins with an 8-byte header: 4-byte chunk id and a
+   * 4-byte little-endian chunk length.  This makes parsing robust against
+   * WAV files that contain extra chunks (JUNK/LIST/bext/fact ...) placed
+   * between the RIFF header and the fmt/data chunks.
+   */
+
+  for (; ; )
+    {
+      uint32_t chunklen;
+
+      /* Read the 8-byte chunk header (id + length) */
+
+      ret = read(fd, buf, 8);
+      if (ret < 8)
+        {
+          break;
+        }
+
+      chunklen = get_le32(&buf[4]);
+
+      if (buf[0] == 'f' && buf[1] == 'm' && buf[2] == 't' && buf[3] == ' ')
+        {
+          uint8_t fmt[16];
+
+          /* The fmt chunk must carry at least 16 bytes of format data */
+
+          if (chunklen < 16)
+            {
+              return -EINVAL;
+            }
+
+          if (read(fd, fmt, sizeof(fmt)) < (int)sizeof(fmt))
+            {
+              return -EIO;
+            }
+
+          /* fmt layout: format(2) channels(2) samplerate(4) byterate(4)
+           * blockalign(2) bitspersample(2)
+           */
+
+          *chans      = (uint8_t)get_le16(&fmt[2]);
+          *samplerate = get_le32(&fmt[4]);
+          *bps        = (uint8_t)get_le16(&fmt[14]);
+          have_fmt    = true;
+
+          /* Skip any extra fmt bytes beyond the standard 16 (plus pad) */
+
+          if (chunklen > 16)
+            {
+              lseek(fd, (off_t)(chunklen - 16) + (chunklen & 1),
+                    SEEK_CUR);
+            }
+        }
+      else if (buf[0] == 'd' && buf[1] == 'a' &&
+               buf[2] == 't' && buf[3] == 'a')
+        {
+          /* The file pointer is now positioned exactly at the start of the
+           * PCM audio samples.  Leave it here so the caller can pre-read
+           * the audio data directly.
+           */
+
+          have_data = true;
+          break;
+        }
+      else
+        {
+          /* Unknown chunk: skip its payload (chunks are word-aligned, so
+           * account for a trailing pad byte when the length is odd).
+           */
+
+          if (lseek(fd, (off_t)chunklen + (chunklen & 1), SEEK_CUR) < 0)
+            {
+              return -EIO;
+            }
+        }
+    }
+
+  if (!have_fmt || !have_data)
+    {
+      return -EINVAL;
+    }
+
+  return OK;
+}
+#endif
+
