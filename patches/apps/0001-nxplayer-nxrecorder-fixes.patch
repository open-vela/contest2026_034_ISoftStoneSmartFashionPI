-
   /* Test that the specified file exists */
 
 #ifdef CONFIG_NXPLAYER_HTTP_STREAMING_SUPPORT
@@ -2196,6 +2521,256 @@ int nxplayer_playraw(FAR struct nxplayer_s *pplayer,
       goto err_out;
     }
 
+  /* Check if file extension is .wav and parse WAV header */
+
+#ifdef CONFIG_AUDIO_FORMAT_PCM
+  if (filefmt == AUDIO_FMT_PCM)
+    {
+      const char *ext = strrchr(pfilename, '.');
+      if (ext != NULL && strcmp(ext, ".wav") == 0)
+        {
+          ret = nxplayer_parse_wav(pplayer->fd, &samprate,
+                                   &nchannels, &bpsamp);
+          if (ret < 0)
+            {
+              goto err_out;
+            }
+        }
+
+      /* Pre-read entire PCM data into PSRAM cache to eliminate file I/O
+       * during playback. This avoids LVGL/LittleFS contention on the
+       * SPI bus and memory bandwidth, which is the root cause of audio
+       * stutter and truncation.
+       */
+
+      if (pplayer->fd >= 0)
+        {
+          off_t pcm_start;
+          off_t pcm_end;
+          off_t pcm_size;
+
+          /* Save current position (PCM data starts here, after header) */
+
+          pcm_start = lseek(pplayer->fd, 0, SEEK_CUR);
+          if (pcm_start < 0)
+            {
+              ret = -errno;
+              auderr("ERROR: lseek(SEEK_CUR) failed: %d\n", ret);
+              goto err_out;
+            }
+
+          /* Get file total size */
+
+          pcm_end = lseek(pplayer->fd, 0, SEEK_END);
+          if (pcm_end < 0)
+            {
+              ret = -errno;
+              auderr("ERROR: lseek(SEEK_END) failed: %d\n", ret);
+              goto err_out;
+            }
+
+          /* Calculate how much PCM data remains */
+
+          pcm_size = pcm_end - pcm_start;
+          if (pcm_size <= 0)
+            {
+              auderr("ERROR: No PCM data to play (size=%ld)\n",
+                     (long)pcm_size);
+              ret = -ENODATA;
+              goto err_out;
+            }
+
+          audinfo("Pre-reading %ld bytes of PCM into PSRAM cache\n",
+                  (long)pcm_size);
+
+          /* Allocate PSRAM cache buffer. */
+
+          pplayer->pcm_cache = (FAR uint8_t *)malloc((size_t)pcm_size);
+          if (pplayer->pcm_cache == NULL)
+            {
+              /* Full preload failed. Try progressively smaller fixed
+               * cache sizes and use chunked pre-read: the playthread
+               * copies from this cache (zero SPI contention) and refills
+               * it from the file whenever it is exhausted.
+               */
+
+              size_t try_sizes[] =
+                {
+                  6 * 1024 * 1024,   /* 6MB - ~97s at 16kHz stereo */
+                  5 * 1024 * 1024,   /* 5MB - ~81s at 16kHz stereo */
+                  4 * 1024 * 1024,   /* 4MB */
+                  3 * 1024 * 1024,   /* 3MB */
+                  2 * 1024 * 1024,   /* 2MB */
+                  1 * 1024 * 1024,   /* 1MB */
+                };
+
+              int i;
+
+              for (i = 0; i < 6; i++)
+                {
+                  if ((off_t)try_sizes[i] < pcm_size)
+                    {
+                      pplayer->pcm_cache =
+                        (FAR uint8_t *)malloc(try_sizes[i]);
+                      if (pplayer->pcm_cache != NULL)
+                        {
+                          pplayer->pcm_cache_cap = (uint32_t)try_sizes[i];
+                          audinfo("chunked cache %zu bytes "
+                                 "allocated\n", try_sizes[i]);
+                          audwarn("WARNING: Full preload failed, using "
+                                  "chunked cache of %zu bytes\n",
+                                  try_sizes[i]);
+                          break;
+                        }
+                    }
+                }
+
+              if (pplayer->pcm_cache == NULL)
+                {
+                  /* Even smallest cache failed, fall back to pure
+                   * streaming.
+                   */
+
+                  audwarn("WARNING: All cache alloc failed, streaming\n");
+                  audinfo("all cache alloc failed, pure "
+                         "streaming\n");
+                  lseek(pplayer->fd, pcm_start, SEEK_SET);
+                  goto skip_preread;
+                }
+
+              /* Fill the first chunk from the PCM data start */
+
+              {
+                /* Fill cache by reading in a loop (partial reads are
+                 * normal on SD card / FAT file systems - a short read
+                 * does NOT mean EOF, only read()==0 does).
+                 */
+
+                size_t total_read = 0;
+
+                lseek(pplayer->fd, pcm_start, SEEK_SET);
+                while (total_read < pplayer->pcm_cache_cap)
+                  {
+                    size_t chunk = pplayer->pcm_cache_cap - total_read;
+                    if (chunk > 8192) chunk = 8192;
+                    ssize_t nread = read(pplayer->fd,
+                                         pplayer->pcm_cache + total_read,
+                                         chunk);
+                    if (nread <= 0)
+                      {
+                        break;  /* EOF (0) or error (-1) */
+                      }
+
+                    total_read += (size_t)nread;
+                  }
+
+                if (total_read == 0)
+                  {
+                    ret = -EIO;
+                    auderr("ERROR: initial chunk read failed\n");
+                    free(pplayer->pcm_cache);
+                    pplayer->pcm_cache = NULL;
+                    goto err_out;
+                  }
+
+                pplayer->pcm_cache_size = (uint32_t)total_read;
+                pplayer->pcm_cache_pos  = 0;
+                pplayer->pcm_cache_eof  =
+                  (total_read < pplayer->pcm_cache_cap);
+                audinfo("initial fill %lu/%lu bytes, eof=%d\n",
+                       (unsigned long)total_read,
+                       (unsigned long)pplayer->pcm_cache_cap,
+                       pplayer->pcm_cache_eof);
+              }
+
+              /* DON'T close fd - it is needed for subsequent refills.
+               * Skip the full pre-read block below.
+               */
+
+              goto skip_preread;
+            }
+
+          /* Seek back to PCM data start and read everything */
+
+          if (lseek(pplayer->fd, pcm_start, SEEK_SET) != pcm_start)
+            {
+              ret = -errno;
+              auderr("ERROR: lseek(SEEK_SET) failed: %d\n", ret);
+              free(pplayer->pcm_cache);
+              pplayer->pcm_cache = NULL;
+              goto err_out;
+            }
+
+          {
+            ssize_t nread;
+            size_t  total_read = 0;
+            size_t  remaining  = (size_t)pcm_size;
+
+            while (remaining > 0)
+              {
+                size_t chunk = remaining;
+
+                /* Cap each read to 8KB so the SDMMC driver's PSRAM
+                 * bounce buffer (allocated from the limited kernel
+                 * heap) can accommodate it.
+                 */
+
+                if (chunk > 8192)
+                  {
+                    chunk = 8192;
+                  }
+
+                nread = read(pplayer->fd,
+                              pplayer->pcm_cache + total_read,
+                              chunk);
+                if (nread < 0)
+                  {
+                    ret = -errno;
+                    auderr("ERROR: read failed: %d\n", ret);
+                    free(pplayer->pcm_cache);
+                    pplayer->pcm_cache = NULL;
+                    goto err_out;
+                  }
+
+                if (nread == 0)
+                  {
+                    break;
+                  }
+
+                total_read += (size_t)nread;
+                remaining  -= (size_t)nread;
+              }
+
+            pplayer->pcm_cache_size = (uint32_t)total_read;
+            pplayer->pcm_cache_pos  = 0;
+            pplayer->pcm_cache_cap  = (uint32_t)total_read;
+            pplayer->pcm_cache_eof  = true;
+
+            /* Sanity check: ensure we read all expected PCM data */
+
+            if (total_read != (size_t)pcm_size)
+              {
+                auderr("ERROR Short read! Expected %ld bytes, got %zu\n",
+                       (long)pcm_size, total_read);
+              }
+
+            audinfo("full preload %lu bytes (actual: %zu)\n",
+                   (unsigned long)pcm_size, total_read);
+          }
+
+          /* Close the file now — all data is in PSRAM.
+           * The playthread will serve data from pcm_cache.
+           */
+
+          close(pplayer->fd);
+          pplayer->fd = -1;
+        }
+
+skip_preread:
+      ;
+    }
+#endif
+
