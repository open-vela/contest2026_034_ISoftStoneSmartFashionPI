@@ -707,6 +846,121 @@ static int nxplayer_readbuffer(FAR struct nxplayer_s *pplayer,
 {
   int ret;
 
+  /* If we have a pre-loaded PSRAM cache, serve data from it instead of
+   * reading from the file. This eliminates all file I/O during playback,
+   * preventing LVGL/LittleFS SPI bus contention from starving the audio
+   * pipeline.
+   */
+
+  if (pplayer->pcm_cache != NULL)
+    {
+      uint32_t remaining;
+      uint32_t to_copy;
+
+      /* Calculate how much data is left in the cache */
+
+      remaining = pplayer->pcm_cache_size - pplayer->pcm_cache_pos;
+
+      /* If the current cache chunk is exhausted, either finish (EOF) or
+       * refill it from the file. Refilling happens synchronously in the
+       * playthread; with a deep audio buffer pool this brief blocking
+       * read does not cause an underrun.
+       */
+
+      if (remaining == 0)
+        {
+          if (pplayer->pcm_cache_eof || pplayer->fd < 0)
+            {
+              /* No more data. Signal end-of-stream with FINAL flag. */
+
+              audinfo("cache exhausted, eof reached\n");
+              apb->nbytes  = 0;
+              apb->curbyte = 0;
+              apb->flags  |= AUDIO_APB_FINAL;
+              return -ENODATA;
+            }
+
+          /* Cache exhausted - refill the entire buffer from the file in
+           * one loop (same as the initial fill). This avoids the periodic
+           * memmove of the incremental top-up path, which held the SPI bus
+           * for tens of milliseconds and starved the I2S DMA, producing
+           * audible glitches.
+           */
+
+          {
+            size_t total_read = 0;
+
+            while (total_read < pplayer->pcm_cache_cap)
+              {
+                size_t chunk = pplayer->pcm_cache_cap - total_read;
+                if (chunk > 8192) chunk = 8192;
+                ssize_t nread = read(pplayer->fd,
+                                     pplayer->pcm_cache + total_read,
+                                     chunk);
+                if (nread <= 0)
+                  {
+                    break;  /* EOF (0) or error (-1) */
+                  }
+
+                total_read += (size_t)nread;
+              }
+
+            if (total_read == 0)
+              {
+                /* True EOF or error - signal end-of-stream. */
+
+                audinfo("refill read failed, eof reached\n");
+                pplayer->pcm_cache_eof = true;
+                apb->nbytes  = 0;
+                apb->curbyte = 0;
+                apb->flags  |= AUDIO_APB_FINAL;
+                return -ENODATA;
+              }
+
+            pplayer->pcm_cache_size = (uint32_t)total_read;
+            pplayer->pcm_cache_pos  = 0;
+            pplayer->pcm_cache_eof  =
+              (total_read < pplayer->pcm_cache_cap);
+
+            audinfo("refill %lu/%lu bytes, eof=%d\n",
+                   (unsigned long)total_read,
+                   (unsigned long)pplayer->pcm_cache_cap,
+                   pplayer->pcm_cache_eof);
+
+            remaining = pplayer->pcm_cache_size;
+          }
+        }
+
+      /* Copy as much as fits in the audio buffer */
+
+      to_copy = remaining;
+      if (to_copy > apb->nmaxbytes)
+        {
+          to_copy = apb->nmaxbytes;
+        }
+
+      memcpy(apb->samp, pplayer->pcm_cache + pplayer->pcm_cache_pos,
+             to_copy);
+      apb->nbytes  = to_copy;
+      apb->curbyte = 0;
+      apb->flags   = 0;
+
+      pplayer->pcm_cache_pos += to_copy;
+
+      /* If this is the last chunk of the whole file, mark it as FINAL */
+
+      if (pplayer->pcm_cache_pos >= pplayer->pcm_cache_size &&
+          pplayer->pcm_cache_eof)
+        {
+          apb->flags |= AUDIO_APB_FINAL;
+          audinfo("PSRAM cache exhausted, marking FINAL\n");
+        }
+
+      return OK;
+    }
+
+  /* No PSRAM cache — use the original file-based read path */
+
   /* Validate the file is still open.  It will be closed automatically when
    * we encounter the end of file (or, perhaps, a read error that we cannot
    * handle.
@@ -854,8 +1108,6 @@ static FAR void *nxplayer_playthread(pthread_addr_t pvarg)
   if ((ret = ioctl(pplayer->dev_fd, AUDIOIOC_GETBUFFERINFO,
