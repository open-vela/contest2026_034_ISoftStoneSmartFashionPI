+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdio.h>
+#include <unistd.h>
+#include <string.h>
+
+#include <nuttx/audio/audio.h>
+#include <nuttx/audio/pcm.h>
+
+#include "system/nxrecorder.h"
+
+#ifdef CONFIG_AUDIO_FORMAT_PCM
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: wav_header_init
+ *
+ * Description:
+ *   Initialize WAV file header with the given parameters.
+ *
+ ****************************************************************************/
+
+static void wav_header_init(FAR struct wav_header_s *wav,
+                            uint32_t samplerate, uint8_t chans,
+                            uint8_t bps)
+{
+  /* Initialize header chunk */
+
+  wav->hdr.chunkid  = WAV_HDR_CHUNKID;   /* "RIFF" */
+  wav->hdr.format   = WAV_HDR_FORMAT;    /* "WAVE" */
+  wav->hdr.chunklen = 0;                 /* Will be updated when recording stops */
+
+  /* Initialize format chunk */
+
+  wav->fmt.chunkid   = WAV_FMT_CHUNKID;  /* "fmt " */
+  wav->fmt.chunklen  = WAV_FMT_CHUNKLEN; /* 16 for PCM */
+  wav->fmt.format    = WAV_FMT_FORMAT;   /* PCM = 1 */
+  wav->fmt.nchannels = chans;
+  wav->fmt.samprate  = samplerate;
+  wav->fmt.bpsamp    = bps;
+  wav->fmt.byterate  = samplerate * chans * (bps / 8);
+  wav->fmt.align     = chans * (bps / 8);
+
+  /* Initialize data chunk */
+
+  wav->data.chunkid  = WAV_DATA_CHUNKID; /* "data" */
+  wav->data.chunklen = 0;                /* Will be updated when recording stops */
+}
+
+/****************************************************************************
+ * Name: wav_header_write
+ *
+ * Description:
+ *   Write WAV file header to the file.
+ *
+ ****************************************************************************/
+
+static int wav_header_write(int fd, FAR struct wav_header_s *wav)
+{
+  int ret;
+
+  ret = write(fd, &wav->hdr.chunkid, sizeof(wav->hdr.chunkid));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->hdr.chunklen, sizeof(wav->hdr.chunklen));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->hdr.format, sizeof(wav->hdr.format));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->fmt.chunkid, sizeof(wav->fmt.chunkid));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->fmt.chunklen, sizeof(wav->fmt.chunklen));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->fmt.format, sizeof(wav->fmt.format));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->fmt.nchannels, sizeof(wav->fmt.nchannels));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->fmt.samprate, sizeof(wav->fmt.samprate));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->fmt.byterate, sizeof(wav->fmt.byterate));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->fmt.align, sizeof(wav->fmt.align));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->fmt.bpsamp, sizeof(wav->fmt.bpsamp));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->data.chunkid, sizeof(wav->data.chunkid));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = write(fd, &wav->data.chunklen, sizeof(wav->data.chunklen));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  return OK;
+}
+
+/****************************************************************************
+ * Name: wav_header_update
+ *
+ * Description:
+ *   Update WAV file header with the actual data size.
+ *
+ ****************************************************************************/
+
+static int wav_header_update(int fd, FAR struct wav_header_s *wav,
+                             uint32_t datasize)
+{
+  int ret;
+
+  /* Update data chunk size */
+
+  wav->data.chunklen = datasize;
+
+  /* Update header chunk size (total file size - 8 bytes for chunkid and chunklen) */
+
+  wav->hdr.chunklen = sizeof(struct wav_formatchunk_s) +
+                      sizeof(struct wav_datachunk_s) + datasize;
+
+  /* Seek to the beginning of the file */
+
+  ret = lseek(fd, 0, SEEK_SET);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  /* Rewrite the header */
+
+  ret = wav_header_write(fd, wav);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  return OK;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: nxrecorder_write_wav
+ *
+ * Description:
+ *   Write WAV file header to the recording file.
+ *
+ ****************************************************************************/
+
+int nxrecorder_write_wav(int fd, uint32_t samplerate,
+                         uint8_t chans, uint8_t bps)
+{
+  struct wav_header_s wav;
+  int ret;
+
+  /* Initialize WAV header */
+
+  wav_header_init(&wav, samplerate, chans, bps);
+
+  /* Write WAV header to file */
+
+  ret = wav_header_write(fd, &wav);
+  if (ret < 0)
+    {
+      printf("ERROR: Failed to write WAV header: %d\n", ret);
+      return ret;
+    }
+
+  printf("WAV header written: samplerate=%lu chans=%u bps=%u\n",
+          (unsigned long)samplerate, chans, bps);
+
+  return OK;
+}
+
+/****************************************************************************
+ * Name: nxrecorder_update_wav
+ *
+ * Description:
+ *   Update WAV file header with the actual data size when recording stops.
+ *
+ ****************************************************************************/
+
+int nxrecorder_update_wav(int fd, uint32_t samplerate,
+                         uint8_t chans, uint8_t bps, uint32_t datasize)
+{
+  struct wav_header_s wav;
+  int ret;
+
+  /* Initialize WAV header */
+
+  wav_header_init(&wav, samplerate, chans, bps);
+
+  /* Update WAV header with actual data size */
+
+  ret = wav_header_update(fd, &wav, datasize);
+  if (ret < 0)
+    {
+      printf("ERROR: Failed to update WAV header: %d\n", ret);
+      return ret;
+    }
+
+  printf("WAV header updated: datasize=%lu\n", (unsigned long)datasize);
+
+  return OK;
+}
