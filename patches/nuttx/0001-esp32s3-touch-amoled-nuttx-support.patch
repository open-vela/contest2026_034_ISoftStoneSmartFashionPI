+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdbool.h>
+#include <time.h>
+#include <errno.h>
+#include <debug.h>
+#include <string.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/i2c/i2c_master.h>
+#include <nuttx/timers/rtc.h>
+
+#include "pcf85063.h"
+
+#ifdef CONFIG_RTC_PCF85063
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#ifndef CONFIG_RTC_DATETIME
+#  error CONFIG_RTC_DATETIME must be set to use this driver
+#endif
+
+#ifdef CONFIG_RTC_HIRES
+#  error CONFIG_RTC_HIRES must NOT be set with this driver
+#endif
+
+#ifndef CONFIG_PCF85063_I2C_FREQUENCY
+#  define CONFIG_PCF85063_I2C_FREQUENCY 400000
+#endif
+
+#if CONFIG_PCF85063_I2C_FREQUENCY > 400000
+#  error CONFIG_PCF85063_I2C_FREQUENCY is out of range
+#endif
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+/****************************************************************************
+ * Private Function Prototypes
+ ****************************************************************************/
+
+/* Prototypes for static methods in struct rtc_ops_s */
+
+static int pcf85063_lh_rdtime(struct rtc_lowerhalf_s *lower,
+                              struct rtc_time *rtctime);
+static int pcf85063_lh_settime(struct rtc_lowerhalf_s *lower,
+                               const struct rtc_time *rtctime);
+static bool pcf85063_lh_havesettime(struct rtc_lowerhalf_s *lower);
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+/* PCF85063 RTC driver operations */
+
+static const struct rtc_ops_s g_pcf85063_ops =
+{
+  .rdtime      = pcf85063_lh_rdtime,
+  .settime     = pcf85063_lh_settime,
+  .havesettime = pcf85063_lh_havesettime,
+#ifdef CONFIG_RTC_ALARM
+  .setalarm    = NULL,
+  .setrelative = NULL,
+  .cancelalarm = NULL,
+  .rdalarm     = NULL,
+#endif
+};
+
+/* PCF85063 device state */
+
+static struct pcf85063_lowerhalf_s g_pcf85063_lowerhalf =
+{
+  .ops = &g_pcf85063_ops,
+  .i2c = NULL,
+  .initialized = false,
+};
+
+/* Flag indicating if RTC has been initialized */
+
+volatile bool g_rtc_enabled = false;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+#ifdef CONFIG_DEBUG_RTC_INFO
+static void rtc_dumptime(FAR struct tm *tp, FAR const char *msg)
+{
+  rtcinfo("%s:\n", msg);
+  rtcinfo("   tm_sec: %08x\n", tp->tm_sec);
+  rtcinfo("   tm_min: %08x\n", tp->tm_min);
+  rtcinfo("  tm_hour: %08x\n", tp->tm_hour);
+  rtcinfo("  tm_mday: %08x\n", tp->tm_mday);
+  rtcinfo("   tm_mon: %08x\n", tp->tm_mon);
+  rtcinfo("  tm_year: %08x\n", tp->tm_year);
+  rtcinfo("  tm_wday: %08x\n", tp->tm_wday);
+}
+#else
+#  define rtc_dumptime(tp, msg)
+#endif
+
+static uint8_t rtc_bin2bcd(int value)
+{
+  uint8_t msbcd = 0;
+
+  while (value >= 10)
+    {
+      msbcd++;
+      value -= 10;
+    }
+
+  return (msbcd << 4) | value;
+}
+
+static int rtc_bcd2bin(uint8_t value)
+{
+  int tens = ((int)value >> 4) * 10;
+  return tens + (value & 0x0f);
+}
+
+static int pcf85063_read_register(FAR struct i2c_master_s *i2c,
+                                  uint8_t reg, uint8_t *buffer,
+                                  int len)
+{
+  struct i2c_msg_s msg[2];
+  uint8_t regaddr;
+  int ret;
+  int i;
+
+  /* Read one register at a time to avoid address auto-increment issues */
+  for (i = 0; i < len; i++)
+    {
+      regaddr = reg + i;
+
+      msg[0].frequency = CONFIG_PCF85063_I2C_FREQUENCY;
+      msg[0].addr      = PCF85063_I2C_ADDRESS;
+      msg[0].flags     = 0;
+      msg[0].buffer    = &regaddr;
+      msg[0].length    = 1;
+
+      msg[1].frequency = CONFIG_PCF85063_I2C_FREQUENCY;
+      msg[1].addr      = PCF85063_I2C_ADDRESS;
+      msg[1].flags     = I2C_M_READ;
+      msg[1].buffer    = &buffer[i];
+      msg[1].length    = 1;
+
+      ret = I2C_TRANSFER(i2c, msg, 2);
+      if (ret < 0)
+        {
+          rtcerr("ERROR: I2C_TRANSFER failed: %d\n", ret);
+          return ret;
+        }
+    }
+
+  return OK;
+}
+
+static int pcf85063_write_register(FAR struct i2c_master_s *i2c,
+                                   uint8_t reg, uint8_t value)
+{
+  struct i2c_msg_s msg[1];
+  uint8_t buffer[2];
+  int ret;
+
+  buffer[0] = reg;
+  buffer[1] = value;
+
+  msg[0].frequency = CONFIG_PCF85063_I2C_FREQUENCY;
+  msg[0].addr      = PCF85063_I2C_ADDRESS;
+  msg[0].flags     = 0;
+  msg[0].buffer    = buffer;
+  msg[0].length    = 2;
+
+  ret = I2C_TRANSFER(i2c, msg, 1);
+  if (ret < 0)
+    {
+      rtcerr("ERROR: I2C_TRANSFER failed: %d\n", ret);
+      return ret;
+    }
+
+  return OK;
+}
+
+/****************************************************************************
+ * Name: pcf85063_lh_rdtime
+ *
+ * Description:
+ *   Returns the current RTC time.
+ *
+ * Input Parameters:
+ *   lower   - A reference to RTC lower half driver state structure
+ *   rtctime - The location in which to return the current RTC time.
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success; a negated errno value is returned
+ *   on any failure.
+ *
+ ****************************************************************************/
+
+static int pcf85063_lh_rdtime(struct rtc_lowerhalf_s *lower,
+                              struct rtc_time *rtctime)
+{
+  FAR struct pcf85063_lowerhalf_s *priv =
+    (FAR struct pcf85063_lowerhalf_s *)lower;
+  uint8_t buffer[7];
+  uint8_t seconds;
+  int ret;
+
+  if (!priv->initialized)
+    {
+      return -ENODEV;
+    }
+
+  /* Read the time registers with rollover handling */
+
+  do
+    {
+      ret = pcf85063_read_register(priv->i2c, PCF85063_REG_SECONDS,
+                                   buffer, 7);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      ret = pcf85063_read_register(priv->i2c, PCF85063_REG_SECONDS,
+                                   &seconds, 1);
+      if (ret < 0)
+        {
+          return ret;
+        }
+    }
+  while ((buffer[0] & PCF85063_SECONDS_MASK) >
+         (seconds & PCF85063_SECONDS_MASK));
+
+  /* Decode the time registers */
+
+  rtctime->tm_sec  = rtc_bcd2bin(buffer[0] & PCF85063_SECONDS_MASK);
+  rtctime->tm_min  = rtc_bcd2bin(buffer[1] & PCF85063_MINUTES_MASK);
+  rtctime->tm_hour = rtc_bcd2bin(buffer[2] & PCF85063_HOURS_24_MASK);
+  rtctime->tm_mday = rtc_bcd2bin(buffer[3] & PCF85063_DAYS_MASK);
+  rtctime->tm_wday = rtc_bcd2bin(buffer[4] & PCF85063_WEEKDAYS_MASK);
+  rtctime->tm_mon  = rtc_bcd2bin(buffer[5] & PCF85063_MONTHS_MASK) - 1;
+
+  uint8_t year = rtc_bcd2bin(buffer[6]);
+  if (year < 50)
+    {
+      rtctime->tm_year = year + 100;
+    }
+  else
+    {
+      rtctime->tm_year = year;
+    }
+
+  rtc_dumptime(rtctime, "Returning");
+  return OK;
+}
+
+/****************************************************************************
+ * Name: pcf85063_lh_settime
+ *
+ * Description:
+ *   Implements the settime() method of the RTC driver interface
+ *
+ * Input Parameters:
+ *   lower   - A reference to RTC lower half driver state structure
+ *   rtctime - The new time to set
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success; a negated errno value is returned
+ *   on any failure.
+ *
+ ****************************************************************************/
+
+static int pcf85063_lh_settime(struct rtc_lowerhalf_s *lower,
+                               const struct rtc_time *rtctime)
+{
+  FAR struct pcf85063_lowerhalf_s *priv =
+    (FAR struct pcf85063_lowerhalf_s *)lower;
+  uint8_t buffer[8];
+  uint8_t seconds;
+  int ret;
+
+  if (!priv->initialized)
+    {
+      return -ENODEV;
+    }
+
+  rtc_dumptime((FAR struct tm *)rtctime, "Setting time");
+
+  buffer[0] = PCF85063_REG_SECONDS;
+  buffer[1] = rtc_bin2bcd(rtctime->tm_sec);
+  buffer[2] = rtc_bin2bcd(rtctime->tm_min);
+  buffer[3] = rtc_bin2bcd(rtctime->tm_hour);
+  buffer[4] = rtc_bin2bcd(rtctime->tm_mday);
+  buffer[5] = rtc_bin2bcd(rtctime->tm_wday);
+  buffer[6] = rtc_bin2bcd(rtctime->tm_mon + 1);
+  buffer[7] = rtc_bin2bcd(rtctime->tm_year % 100);
+
+  /* Write time registers with rollover handling */
+
+  do
+    {
+      ret = pcf85063_write_register(priv->i2c, PCF85063_REG_SECONDS,
+                                    buffer[1]);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      ret = pcf85063_write_register(priv->i2c, PCF85063_REG_MINUTES,
+                                    buffer[2]);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      ret = pcf85063_write_register(priv->i2c, PCF85063_REG_HOURS,
+                                    buffer[3]);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      ret = pcf85063_write_register(priv->i2c, PCF85063_REG_DAYS,
+                                    buffer[4]);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      ret = pcf85063_write_register(priv->i2c, PCF85063_REG_WEEKDAYS,
+                                    buffer[5]);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      ret = pcf85063_write_register(priv->i2c, PCF85063_REG_MONTHS,
+                                    buffer[6]);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      ret = pcf85063_write_register(priv->i2c, PCF85063_REG_YEARS,
+                                    buffer[7]);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      /* Verify the seconds register */
+
+      ret = pcf85063_read_register(priv->i2c, PCF85063_REG_SECONDS,
+                                   &seconds, 1);
+      if (ret < 0)
+        {
+          return ret;
+        }
+    }
+  while ((buffer[1] & PCF85063_SECONDS_MASK) >
+         (seconds & PCF85063_SECONDS_MASK));
+
+  return OK;
+}
+
+/****************************************************************************
+ * Name: pcf85063_lh_havesettime
+ *
+ * Description:
+ *   Implements the havesettime() method of the RTC driver interface
+ *
+ * Input Parameters:
+ *   lower - A reference to RTC lower half driver state structure
+ *
+ * Returned Value:
+ *   Returns true if RTC date-time have been previously set.
+ *
+ ****************************************************************************/
+
+static bool pcf85063_lh_havesettime(struct rtc_lowerhalf_s *lower)
+{
+  FAR struct pcf85063_lowerhalf_s *priv =
+    (FAR struct pcf85063_lowerhalf_s *)lower;
+  uint8_t seconds;
+  int ret;
+
+  if (!priv->initialized)
+    {
+      return false;
+    }
+
+  ret = pcf85063_read_register(priv->i2c, PCF85063_REG_SECONDS,
+                               &seconds, 1);
+  if (ret < 0)
+    {
+      return false;
+    }
+
+  /* If the oscillator stop bit is set, time has not been set */
+
+  return !(seconds & PCF85063_SECONDS_OS);
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: pcf85063_rtc_initialize
+ *
+ * Description:
+ *   Initialize the hardware RTC per the selected configuration.
+ *   This function is called once during the OS initialization sequence by
+ *   board-specific logic.
+ *
+ * Input Parameters:
+ *   i2c - An instance of the I2C interface to use to communicate with the RTC
+ *
+ * Returned Value:
+ *   Zero (OK) on success; a negated errno on failure
+ *
+ ****************************************************************************/
+
+int pcf85063_rtc_initialize(FAR struct i2c_master_s *i2c)
+{
+  uint8_t control1;
+  int ret;
+
+  /* Store the I2C device */
+
+  g_pcf85063_lowerhalf.i2c = i2c;
+
+  /* Read control1 register to check if RTC is stopped */
+
+  ret = pcf85063_read_register(i2c, PCF85063_REG_CONTROL1,
+                               &control1, 1);
+  if (ret < 0)
+    {
+      rtcerr("ERROR: Failed to read control1: %d\n", ret);
+      return ret;
+    }
+
+  /* If the STOP bit is set, clear it to start the RTC */
+
+  if (control1 & PCF85063_CONTROL1_STOP)
+    {
+      ret = pcf85063_write_register(i2c, PCF85063_REG_CONTROL1,
+                                    control1 & ~PCF85063_CONTROL1_STOP);
+      if (ret < 0)
+        {
+          rtcerr("ERROR: Failed to clear STOP bit: %d\n", ret);
+          return ret;
+        }
+
+      /* Wait for oscillator to stabilize (minimum 3 seconds per datasheet) */
+
+      up_mdelay(3000);
+
+      /* Verify that oscillator is running by checking the OS bit */
+
+      {
+        uint8_t seconds;
+        ret = pcf85063_read_register(i2c, PCF85063_REG_SECONDS,
+                                     &seconds, 1);
+        if (ret < 0)
+          {
+            rtcerr("ERROR: Failed to read seconds register: %d\n", ret);
+            return ret;
+          }
+
+        if (seconds & PCF85063_SECONDS_OS)
+          {
+            rtcerr("WARNING: Oscillator not running (OS bit set)\n");
+          }
+      }
+    }
+
+  /* Mark as initialized */
+
+  g_pcf85063_lowerhalf.initialized = true;
+  g_rtc_enabled = true;
+
+  /* Register the RTC device at /dev/rtc0 */
+
+  ret = rtc_initialize(0, (struct rtc_lowerhalf_s *)&g_pcf85063_lowerhalf);
+  if (ret < 0)
+    {
+      rtcerr("ERROR: Failed to register RTC device: %d\n", ret);
+      return ret;
+    }
+
+  return OK;
+}
+
+/****************************************************************************
+ * Name: up_rtc_getdatetime
+ *
+ * Description:
+ *   Get the current date and time from the date/time RTC.
+ *   This interface is only supported by the date/time RTC hardware
+ *   implementation.
+ *
+ * Input Parameters:
+ *   tp - The location to return the high resolution time value.
+ *
+ * Returned Value:
+ *   Zero (OK) on success; a negated errno on failure
+ *
+ ****************************************************************************/
+
+int up_rtc_getdatetime(FAR struct tm *tp)
+{
+  struct rtc_time rtctime;
+  int ret;
+
+  if (!g_rtc_enabled)
+    {
+      return -EAGAIN;
+    }
+
+  ret = pcf85063_lh_rdtime((struct rtc_lowerhalf_s *)&g_pcf85063_lowerhalf,
+                           &rtctime);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  memcpy(tp, &rtctime, sizeof(struct tm));
+  return OK;
+}
+
+/****************************************************************************
+ * Name: up_rtc_settime
+ *
+ * Description:
+ *   Set the RTC to the provided time.
+ *
+ * Input Parameters:
+ *   ts - The time to use
+ *
+ * Returned Value:
+ *   Zero (OK) on success; a negated errno on failure
+ *
+ ****************************************************************************/
+
+int up_rtc_settime(FAR const struct timespec *ts)
+{
+  struct tm newtm;
+  time_t newtime;
+  int ret;
+
+  if (!g_rtc_enabled)
+    {
+      return -EAGAIN;
+    }
+
+  newtime = (time_t)ts->tv_sec;
+  if (ts->tv_nsec >= 500000000)
+    {
+      newtime++;
+    }
+
+  if (localtime_r(&newtime, &newtm) == NULL)
+    {
+      return -EINVAL;
+    }
+
+  ret = pcf85063_lh_settime((struct rtc_lowerhalf_s *)&g_pcf85063_lowerhalf,
+                            (const struct rtc_time *)&newtm);
+  return ret;
+}
+
+#endif /* CONFIG_RTC_PCF85063 */
