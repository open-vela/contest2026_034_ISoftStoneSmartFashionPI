+#if !defined(CONFIG_DEBUG_INFO)
+#  define _info       _none
+#elif defined(CONFIG_CPP_HAVE_VARARGS)
+#  define _info(format, ...) \
+   __arch_syslog(LOG_INFO, EXTRA_FMT format EXTRA_ARG, ##__VA_ARGS__)
