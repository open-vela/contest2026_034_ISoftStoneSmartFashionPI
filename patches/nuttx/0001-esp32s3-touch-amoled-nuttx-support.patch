+
+static int co5300_putrun(FAR struct lcd_dev_s *dev, fb_coord_t row,
+                         fb_coord_t col, FAR const uint8_t *buffer,
+                         size_t npixels)
+{
+  return co5300_putarea(dev, row, row, col, col + npixels - 1,
+                        buffer, npixels * (BSP_LCD_BPP / 8));
+}
+
+static int co5300_putarea(FAR struct lcd_dev_s *dev,
+                          fb_coord_t row_start, fb_coord_t row_end,
+                          fb_coord_t col_start, fb_coord_t col_end,
+                          FAR const uint8_t *buffer, fb_coord_t stride)
+{
+  FAR struct esp32s3_co5300_dev_s *priv =
+    (FAR struct esp32s3_co5300_dev_s *)dev;
+
+  int width  = col_end - col_start + 1;
+  int rowlen = width * (BSP_LCD_BPP / 8);
+
+  DEBUGASSERT(dev && buffer);
+
+  /* Pixel staging, PSRAM cache writeback and TE vblank sync are all handled
+   * inside lcd_write_color().
+   */
+
+  /* lcd_write_window_mem uses EXCLUSIVE x_end/y_end */
+
+  if (stride == rowlen)
+    {
+      lcd_write_window_mem(priv, col_start, row_start,
+                           col_end + 1, row_end + 1, buffer);
+    }
+  else
+    {
+      for (fb_coord_t row = row_start; row <= row_end; row++)
+        {
+          lcd_write_window_mem(priv, col_start, row,
+                               col_end + 1, row + 1,
+                               buffer + (row - row_start) * stride);
+        }
+    }
+
+  return OK;
+}
