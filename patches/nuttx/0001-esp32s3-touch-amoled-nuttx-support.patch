+CHIP_CSRCS += ssl_tls13_client.c
+CHIP_CSRCS += ssl_tls13_generic.c
+CHIP_CSRCS += ssl_tls13_keys.c
+CHIP_CSRCS += ssl_tls13_server.c
+CHIP_CSRCS += x509.c
+CHIP_CSRCS += x509_crl.c
+CHIP_CSRCS += x509_crt.c
+
 VPATH += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)mbedtls$(DELIM)port
 
 CHIP_CSRCS += esp_hardware.c
@@ -209,7 +244,17 @@ VPATH += $(WIFI_WPA_SUPPLICANT)$(DELIM)src$(DELIM)utils
 
 INCLUDES += $(INCDIR_PREFIX)$(ARCH_SRCDIR)$(DELIM)$(WIFI_WPA_SUPPLICANT)$(DELIM)src$(DELIM)utils
 
-CHIP_CSRCS += base64.c
+# NOTE: base64.c is intentionally NOT added here.  The wpa_supplicant utils
+# base64.c provides base64_encode()/base64_decode(), which are only referenced
+# by sources that are not compiled in this configuration (src/tls/tlsv1_cred.c,
+# src/common/dpp.c, src/wps/wps_registrar.c).  Moreover it shares the base64.o
+# object name with mbedtls/library/base64.c added above (which the ESP mbedtls
+# port renames to esp_mbedtls_base64_encode/decode via esp_mbedtls.h and is
+# required by the TLS layer and cwebsocket/WSS).  Because the mbedtls library
+# VPATH precedes the wpa_supplicant utils VPATH, base64.o already resolves to
+# the mbedtls version; keeping this line only produced a duplicate-target
+# warning ("target base64.o given more than once") without adding any used
+# symbol, so it is removed.
 CHIP_CSRCS += bitfield.c
 CHIP_CSRCS += common.c
 CHIP_CSRCS += ext_password.c
diff --git a/arch/xtensa/src/esp32s3/esp32s3_dma.c b/arch/xtensa/src/esp32s3/esp32s3_dma.c
index e0a2439a4c8..e528a0b65a9 100644
--- a/arch/xtensa/src/esp32s3/esp32s3_dma.c
+++ b/arch/xtensa/src/esp32s3/esp32s3_dma.c
@@ -321,14 +321,13 @@ uint32_t esp32s3_dma_setup(struct esp32s3_dmadesc_s *dmadesc, uint32_t num,
       pdata += data_len;
     }
 
-  /* suc_eof (defined by ESP32S3_DMA_CTRL_EOF) is set by software
-   * only in transmit descriptor.
+  /* suc_eof (defined by ESP32S3_DMA_CTRL_EOF) must be set in the last
+   * descriptor for both TX and RX. For RX, GDMA triggers
+   * DMA_IN_SUC_EOF_CH0_INT only when it processes a descriptor with
+   * suc_eof=1. Without this, the RX DMA completion interrupt never fires.
    */
 
-  if (tx)
-    {
-      dmadesc[i].ctrl |= ESP32S3_DMA_CTRL_EOF;
-    }
+  dmadesc[i].ctrl |= ESP32S3_DMA_CTRL_EOF;
 
   dmadesc[i].next  = NULL;
 
@@ -361,12 +360,13 @@ void esp32s3_dma_load(struct esp32s3_dmadesc_s *dmadesc, int chan, bool tx)
 
   if (tx)
     {
-      /* Reset DMA TX channel FSM and FIFO pointer */
-
-      SET_GDMA_CH_BITS(DMA_OUT_CONF0_CH0_REG, chan, DMA_OUT_RST_CH0_M);
-      CLR_GDMA_CH_BITS(DMA_OUT_CONF0_CH0_REG, chan, DMA_OUT_RST_CH0_M);
-
-      /* Set the descriptor link base address for TX channel */
+      /* Do NOT reset the DMA TX channel here. The initial reset is done
+       * by i2s_tx_channel_start() during I2S initialization. Resetting
+       * the DMA between every buffer flushes the DMA FIFO, creating a
+       * data gap that causes regular pop noise in the audio output.
+       * Just load the new descriptor address — the DMA has already
+       * stopped at EOF and will restart from the new descriptor.
+       */
 
       regval = (uint32_t)dmadesc & DMA_OUTLINK_ADDR_CH0;
       CLR_GDMA_CH_BITS(DMA_OUT_LINK_CH0_REG, chan, DMA_OUTLINK_ADDR_CH0);
@@ -374,12 +374,9 @@ void esp32s3_dma_load(struct esp32s3_dmadesc_s *dmadesc, int chan, bool tx)
     }
