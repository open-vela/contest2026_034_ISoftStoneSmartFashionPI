+{
+  static struct battery_charger_dev_s *g_axp2101_dev = NULL;
+  g_axp2101_dev = get_axp2101_dev();
+  return axp2101_get_batt_voltage_internal((FAR struct axp2101_dev_s *)g_axp2101_dev);
+}
+
+float axp2101_get_battery_remaining_time(void)
+{
+  uint8_t soc = axp2101_get_pmu_soc();
+
+  if (soc == 0) {
+    return 0.0f;
+  }
+
+  static const float full_capacity = 400.0f;
+  static const float default_discharge_current = 80.0f;
+  float remaining_capacity = (soc / 100.0f) * full_capacity;
+
+  return remaining_capacity / default_discharge_current;
+}
+
+void axp2101_convert_hours_to_hmin(float hours, char* buffer, size_t buffer_size)
+{
+  int h = (int)hours;
+  int min = (int)round((hours - h) * 60);
+
+  if (min >= 60) {
+    h += min / 60;
+    min = min % 60;
+  }
+
+  if (buffer_size >= 16) {
+    snprintf(buffer, buffer_size, "%dh %dmin", h, min);
+  } else if (buffer_size > 0) {
+    snprintf(buffer, buffer_size, "%dh", h);
+  }
+}
