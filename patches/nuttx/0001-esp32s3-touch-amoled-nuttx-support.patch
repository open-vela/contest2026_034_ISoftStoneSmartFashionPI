+#define QMI8658_GYRO_ODR_1793_6Hz  (0x02)
+#define QMI8658_GYRO_ODR_896_8Hz   (0x03)
+#define QMI8658_GYRO_ODR_448_4Hz   (0x04)
+#define QMI8658_GYRO_ODR_224_2Hz   (0x05)
+#define QMI8658_GYRO_ODR_112_1Hz   (0x06)
