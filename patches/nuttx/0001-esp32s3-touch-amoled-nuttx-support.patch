+#!/usr/bin/env python3
+"""
+使用 littlefs-python 生成 LittleFS 镜像
+替代有 bug 的 mklfs 工具
+"""
+
+import os
+import sys
+import argparse
+from pathlib import Path
+
+try:
+    from littlefs import LittleFS
+except ImportError:
+    print("错误: 需要安装 littlefs-python")
+    print("  pip install littlefs-python")
+    sys.exit(1)
+
+
+def build_littlefs_image(source_dir: str, output_file: str, block_size: int, block_count: int, read_size: int, prog_size: int):
+    """打包目录到 LittleFS 镜像"""
+    source_path = Path(source_dir).resolve()
+    
+    print(f"创建 LittleFS: block_size={block_size}, block_count={block_count}, read_size={read_size}, prog_size={prog_size}")
+    fs = LittleFS(
+        block_size=block_size,
+        block_count=block_count,
+        read_size=read_size,
+        prog_size=prog_size,
+    )
+    
+    total_files = 0
+    total_size = 0
+    
+    for root, dirs, files in os.walk(source_path):
+        root_path = Path(root)
+        rel_root = root_path.relative_to(source_path)
+        
+        # 在 LittleFS 中创建目录
+        if rel_root != Path('.'):
+            fs.makedirs(str(rel_root).replace('\\', '/'), exist_ok=True)
+        
+        for file in files:
+            src_file = root_path / file
+            if rel_root == Path('.'):
+                dst_path = file
+            else:
+                dst_path = str(rel_root / file).replace('\\', '/')
+            
+            data = src_file.read_bytes()
+            with fs.open(dst_path, 'wb') as f:
+                f.write(data)
+            
+            total_files += 1
+            total_size += len(data)
+            print(f"  [{total_files}] {dst_path} ({len(data)} bytes)")
+    
+    # 写入镜像
+    with open(output_file, 'wb') as f:
+        f.write(fs.context.buffer)
+    
+    img_size = len(fs.context.buffer)
+    print(f"\n镜像生成成功:")
+    print(f"  文件数: {total_files}")
+    print(f"  数据总量: {total_size} bytes")
+    print(f"  镜像大小: {img_size} bytes ({img_size / 1024 / 1024:.2f} MB)")
+    print(f"  输出文件: {output_file}")
+
+
+def main():
+    parser = argparse.ArgumentParser(description='打包目录到 LittleFS 镜像')
+    parser.add_argument('-c', '--source', required=True, help='源目录')
+    parser.add_argument('-o', '--output', required=True, help='输出镜像文件')
+    parser.add_argument('-b', '--block-size', type=int, default=4096, help='Block size (默认 4096)')
+    parser.add_argument('-s', '--block-count', type=int, required=True, help='Block count')
+    parser.add_argument('-r', '--read-size', type=int, default=1024, help='Read size (默认 1024)')
+    parser.add_argument('-p', '--prog-size', type=int, default=1024, help='Prog size (默认 1024)')
+    args = parser.parse_args()
+    
+    build_littlefs_image(
+        source_dir=args.source,
+        output_file=args.output,
+        block_size=args.block_size,
+        block_count=args.block_count,
+        read_size=args.read_size,
+        prog_size=args.prog_size,
+    )
+
+
+if __name__ == '__main__':
+    main()
