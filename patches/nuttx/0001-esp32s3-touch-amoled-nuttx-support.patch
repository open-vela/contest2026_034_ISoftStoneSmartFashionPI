+static int axp2101_poweroff(FAR struct battery_charger_dev_s *dev)
+{
+  FAR struct axp2101_dev_s *priv = (FAR struct axp2101_dev_s *)dev;
+  int                      ret;
+  uint8_t                  reg = 0;
+
+  reg |= (1 << 0);  // 结果就是 0000 0001
+
+  ret = axp2101_putreg8(priv, AXP2101_COMMON_CONFIGURE_CTL, reg);
+  if (ret != OK)
+    {
+      return ret;
+    }
+  
+  return OK;
+}
+
+
+static int axp2101_reset(FAR struct battery_charger_dev_s *dev)
+{
+  FAR struct axp2101_dev_s *priv = (FAR struct axp2101_dev_s *)dev;
+  int                      ret;
+  uint8_t                  reg = 0;
+
+  reg  |= (1 << 1);  // 结果就是 0000 0010
+
+  ret = axp2101_putreg8(priv, AXP2101_COMMON_CONFIGURE_CTL, reg);
+  if (ret != OK)
+    {
+      return ret;
+    }
+  
+  return OK;
+}
+
+static int axp2101_get_soc(FAR struct battery_charger_dev_s *dev, uint8_t *soc)
+{
+  FAR struct axp2101_dev_s *priv = (FAR struct axp2101_dev_s *)dev;
+  int                      ret;
+  uint8_t                  reg = 0x1D;
+
+  ret = axp2101_putreg8(priv, ADC_CHANNEL_CTRL, reg);  //先写寄存器0x30使能 ADC 测量通道
+  if (ret != OK)
+    {
+      return ret;
+    }
+
+  ret = axp2101_getreg8(priv, AXP2101_BATTERY_PERCENTAGE_DATA, soc);
+  if (ret != OK)
+    {
+      return ret;
+    }
+
+  return OK;
+}
