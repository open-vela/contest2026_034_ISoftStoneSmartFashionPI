+uint8_t axp2101_get_pmu_soc(void)
+{
+  uint8_t axp2101_soc = 0;
+  static struct battery_charger_dev_s *g_axp2101_dev = NULL;
+  g_axp2101_dev=get_axp2101_dev();
+
+  axp2101_get_soc(g_axp2101_dev, &axp2101_soc);
+
+  return axp2101_soc;
+  
+}
+
+uint8_t axp2101_get_pmu_charge_status(void)
+{
+  uint8_t status = 0;
+  static struct battery_charger_dev_s *g_axp2101_dev = NULL;
+  g_axp2101_dev=get_axp2101_dev();
+  axp2101_get_power_charge_status(g_axp2101_dev, &status);
+
+  status = (status >> 5) & 0x03;   //获取 6:5位
+ 
+  /*
+  status:
+  00 standby     待机
+  01 charge      充电
+  10 discharge   放电
+  11 resvered    保留
+  */
+  return status;
+}
+
+uint8_t axp2101_get_vbus_status(void)
+{
+  uint8_t status = 0;
+  struct battery_charger_dev_s *dev = get_axp2101_dev();
+
+  /* 驱动未初始化时（开机早期）返回0=未插入，避免空指针访问 */
+  if (dev == NULL)
+    {
+      return 0;
+    }
+
+  axp2101_get_power_charge_status(dev, &status);
+
+  /* 实测验证（2026-08-31 日志）：0x01 Bit3 恒为0，不是 VBUS 插入位。
+   * 改用 6:5 充电状态位推断：
+   *   10=放电   → 未插充电器
+   *   01=充电中 → 插着
+   *   00=待机   → 仅插着充电器时出现（充满停充/待机）
+   * 即「非放电=充电器插着」——充满后 6:5 变待机时图标仍保持闪电。 */
+  uint8_t chg = (status >> 5) & 0x03;
+  return (chg != 2) ? 1 : 0;
+}
