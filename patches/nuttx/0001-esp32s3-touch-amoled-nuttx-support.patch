+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Public Types
+ ****************************************************************************/
+
+/* This structure is used to configure the ES7210 lower half driver */
+
+struct es7210_lower_s
+{
+  uint32_t frequency;   /* I2C frequency */
+  uint8_t  address;     /* I2C address (7-bit, default 0x41) */
+};
+
+/* Forward declaration of ES7210 device private structure */
+
+struct es7210_dev_s;
+
+/****************************************************************************
+ * Public Data
+ ****************************************************************************/
+
+#ifdef __cplusplus
+#define EXTERN extern "C"
+extern "C"
+{
+#else
+#define EXTERN extern
+#endif
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: es7210_initialize
+ *
+ * Description:
+ *   Initialize the ES7210 ADC codec chip.
+ *
+ * Input Parameters:
+ *   i2c     - An instance of the I2C interface to use to communicate with
+ *             the ES7210
+ *   i2s     - An instance of the I2S interface to use for audio data
+ *   lower   - Platform-specific lower half configuration
+ *
+ * Returned Value:
+ *   A new lower half audio interface for the ES7210 on success; NULL on
+ *   failure.
+ *
+ ****************************************************************************/
+
+FAR struct audio_lowerhalf_s *
+es7210_initialize(FAR struct i2c_master_s *i2c,
+                  FAR struct i2s_dev_s *i2s,
+                  FAR const struct es7210_lower_s *lower);
+
+/****************************************************************************
+ * Name: es7210_get_device
+ *
+ * Description:
+ *   Get the ES7210 device private instance.
+ *
+ * Returned Value:
+ *   Pointer to ES7210 device structure, or NULL if not initialized.
+ *
+ ****************************************************************************/
+
+FAR struct es7210_dev_s *es7210_get_device(void);
+
+/****************************************************************************
+ * Name: es7210_writereg
+ *
+ * Description:
+ *   Write a value to an ES7210 register via I2C.
+ *
+ ****************************************************************************/
+
+int es7210_writereg(FAR struct es7210_dev_s *priv, uint8_t regaddr,
+                    uint8_t regval);
+
+/****************************************************************************
+ * Name: es7210_readreg
+ *
+ * Description:
+ *   Read a value from an ES7210 register via I2C.
+ *
+ ****************************************************************************/
+
+int es7210_readreg(FAR struct es7210_dev_s *priv, uint8_t regaddr,
+                   FAR uint8_t *regval);
+
+/****************************************************************************
+ * Name: es7210_set_mic_mute
+ *
+ * Description:
+ *   Set microphone mute state. The mute state persists across
+ *   es7210_reset() calls, so it remains effective even when
+ *   nxrecorder starts/stops recording.
+ *
+ * Input Parameters:
+ *   mute - true to mute, false to unmute
+ *
+ ****************************************************************************/
+
+bool es7210_get_mic_mute(void);
+
+void es7210_set_mic_mute(bool mute);
+
+#undef EXTERN
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __INCLUDE_NUTTX_AUDIO_ES7210_H */
