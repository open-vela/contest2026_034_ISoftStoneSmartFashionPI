+## SSL/TLS layer (needed by applications using HTTPS/WSS)
+
+CHIP_CSRCS += base64.c
+CHIP_CSRCS += error.c
+CHIP_CSRCS += net_sockets.c
+CHIP_CSRCS += esp_platform_time.c
+CHIP_CSRCS += ssl_cache.c
+
+# net_sockets.c has a platform guard that #errors unless one of unix/__unix__/
+# __APPLE__/_WIN32 etc. is defined.  NuttX defines none of these, but it does
+# provide a full POSIX socket API (socket/connect/bind/listen/accept/send/recv/
+# close/select), so the Unix code path compiles and works fine.  Define "unix"
+# for this single file only to satisfy the guard.  The variable name must match
+# the VPATH-resolved path used by the build rule ($< in tools/Config.mk).
+chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)mbedtls$(DELIM)mbedtls$(DELIM)library$(DELIM)net_sockets.c_CFLAGS += -Dunix
+CHIP_CSRCS += ssl_ciphersuites.c
+CHIP_CSRCS += ssl_client.c
+CHIP_CSRCS += ssl_cookie.c
+CHIP_CSRCS += ssl_debug_helpers_generated.c
+CHIP_CSRCS += ssl_msg.c
+CHIP_CSRCS += ssl_ticket.c
+CHIP_CSRCS += ssl_tls.c
+CHIP_CSRCS += ssl_tls12_client.c
