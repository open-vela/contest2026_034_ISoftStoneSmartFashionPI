+  /* RGB565 RED: R=31(0x1F), G=0, B=0 => 0xF800 */
+  for (int i = 0; i < chunk_size; i += 2)
+    {
+      chunk_buffer[i]     = 0xf8;  /* Low byte */
+      chunk_buffer[i + 1] = 0x00;  /* High byte */
+    }
+
+  /* Transfer full screen in chunks */
+  int total_chunks = (502 + CHUNK_HEIGHT - 1) / CHUNK_HEIGHT;
+  printf("CO5300: Transferring %d chunks to fill 410x502 screen...\n", total_chunks);
+
+  for (int y = 0; y < 502; y += CHUNK_HEIGHT)
+    {
+      int height = (y + CHUNK_HEIGHT > 502) ? (502 - y) : CHUNK_HEIGHT;
+
+      /* lcd_write_window_mem uses EXCLUSIVE end coordinates */
+      lcd_write_window_mem(priv, 0, y, 410, y + height, chunk_buffer);
+    }
+
+  kmm_free(chunk_buffer);
+  printf("CO5300: test amoled success - should show FULL RED screen\n");
