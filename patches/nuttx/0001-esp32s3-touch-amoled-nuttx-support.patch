+
+  priv = kmm_zalloc(sizeof(struct axp2101_dev_s));
+
+  if (priv)
+    {
+      /* Initialize the axp2101 device structure */
+
+      priv->dev.ops   = &g_axp2101ops;
+      priv->i2c       = i2c;
+      priv->addr      = addr;
+      priv->frequency = frequency;
+    }
+
+  #if 0
+  axp2101_getreg8(priv, AXP2101_IC_TYPE, &chipid);
+
+  if (AXP2101_CHIP_ID != chipid)
+    {
+      kmm_free(priv);
+      return NULL;
+    }
+  #endif
+
+  // axp2101_set_dcdc1_voltage(priv,CONFIG_AXP2101_DCDC1_VOLTAGE);
+  // axp2101_set_dcdc2_voltage(priv,CONFIG_AXP2101_DCDC2_VOLTAGE);
+  // axp2101_set_dcdc3_voltage(priv,CONFIG_AXP2101_DCDC3_VOLTAGE);
+  // axp2101_set_dcdc4_voltage(priv,CONFIG_AXP2101_DCDC4_VOLTAGE);
+
+  // axp2101_set_aldo1_voltage(priv,CONFIG_AXP2101_ALDO1_VOLTAGE);
+  // axp2101_set_aldo2_voltage(priv,CONFIG_AXP2101_ALDO2_VOLTAGE);
+  // axp2101_set_aldo3_voltage(priv,CONFIG_AXP2101_ALDO3_VOLTAGE);
