+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/types.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <assert.h>
+#include <errno.h>
+#include <debug.h>
+#include <stdio.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/spi/qspi.h>
+#include <nuttx/lcd/lcd.h>
+#include <nuttx/video/fb.h>
+#include <stdlib.h>
+#include <nuttx/kmalloc.h>
+#include <nuttx/irq.h>
+#include <nuttx/semaphore.h>
+#include <nuttx/clock.h>
+#include "esp32s3_gpio.h"
+#include "esp32s3_qspi.h"
+
+/* ROM cache maintenance.
+ *
+ * The patched Cache_WriteBack_Addr() wrapper depends on
+ * cache_writeback_items_freeze (an assembly helper not built in this config),
+ * so linking against it fails.  Call the raw ROM symbols directly instead --
+ * they are PROVIDE'd as fixed addresses by esp32s3.rom.ld and pull in no
+ * objects.  The patch wrapper only exists to fix a ROM bug for UNALIGNED
+ * start/end cachelines; we side-step that by keeping the buffer 64-byte
+ * aligned and rounding the flush size up to a 32-byte cache line.
+ */
+
+extern int      rom_Cache_WriteBack_Addr(uint32_t addr, uint32_t size);
+extern uint32_t Cache_Suspend_DCache_Autoload(void);
+extern void     Cache_Resume_DCache_Autoload(uint32_t autoload);
+
+/* ESP32-S3 external RAM (PSRAM) address window.  Declared locally so this
+ * driver does not need to pull in hardware/esp32s3_soc.h (which depends on
+ * soc/soc.h that is not on the drivers/lcd include path).
+ */
+
+#define CO5300_EXTRAM_LOW   0x3c000000ul
+#define CO5300_EXTRAM_HIGH  0x3e000000ul
+
+static inline bool co5300_ptr_extram(const void *p)
+{
+  return ((uintptr_t)p >= CO5300_EXTRAM_LOW &&
+          (uintptr_t)p <  CO5300_EXTRAM_HIGH);
+}
+
+
+
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define WRITE_CMD           0x02
+#define WRITE_COLOR         0x32
+#define LCD_QSPI_MAX_CHUNK  32768
+
+#define LCD_SPI_PORT        2
+#define LCD_QSPI_FREQ       80000000
+
+#define BSP_LCD_H_RES       410
+#define BSP_LCD_V_RES       502
+#define BSP_LCD_BPP         16    //RGB565
+#define BSP_LCD_COLORFMT    FB_FMT_RGB16_565
+#define DISPLAY_RST_CO5300  8
+#define SWAP_RGB565         1     /* 0: No swap, 1: Swap bytes for LVGL compatibility */
+#define DISPLAY_TE_CO5300   13    /* Tearing Effect (TE) sync input GPIO */
+#define TE_SYNC             1     /* 1: wait panel TE (vblank) before frame write */
+#define TE_EDGE             FALLING /* TE active edge: try RISING if tearing persists */
+#define TE_WAIT_TIMEOUT_MS  20    /* fallback timeout if a TE edge is missed */
+#define TE_DIAG             1     /* 1: periodically log TE fire/timeout stats */
+#define GAPFREE_STREAM      0     /* 1: pre-swap whole frame to PSRAM, stream gap-free */
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+struct esp32s3_co5300_dev_s
+{
+  struct lcd_dev_s dev;
+  struct qspi_dev_s *qspi;
+  uint8_t power;
+#if SWAP_RGB565
+  uint8_t swap_buf[LCD_QSPI_MAX_CHUNK] aligned_data(4);
+#endif
+#if TE_SYNC
+  sem_t te_sem;
+#endif
+};
+
+typedef struct
+{
+  uint8_t cmd;
+  const uint8_t *data;
+  uint8_t data_bytes;
+  uint8_t delay_ms;
+} lcd_init_cmd_t;
+
+
+/****************************************************************************
+ * Private Function Prototypes
+ ****************************************************************************/
+
+static int co5300_getvideoinfo(FAR struct lcd_dev_s *dev, FAR struct fb_videoinfo_s *vinfo);
+static int co5300_getplaneinfo(FAR struct lcd_dev_s *dev, unsigned int planeno, FAR struct lcd_planeinfo_s *pinfo);
+static int co5300_setpower(FAR struct lcd_dev_s *dev, int power);
+static int co5300_getpower(FAR struct lcd_dev_s *dev);
+static int co5300_getcontrast(FAR struct lcd_dev_s *dev);
+static int co5300_setcontrast(FAR struct lcd_dev_s *dev, unsigned int contrast);
+static int co5300_getframerate(FAR struct lcd_dev_s *dev);
+static int co5300_setframerate(FAR struct lcd_dev_s *dev, int rate);
+static int co5300_putrun(FAR struct lcd_dev_s *dev, fb_coord_t row, fb_coord_t col, FAR const uint8_t *buffer, size_t npixels);
+static int co5300_putarea(FAR struct lcd_dev_s *dev, fb_coord_t row_start, fb_coord_t row_end,
+                          fb_coord_t col_start, fb_coord_t col_end, FAR const uint8_t *buffer, fb_coord_t stride);
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static const lcd_init_cmd_t lcd_init_cmds[] =
+{
+  {0x36, (uint8_t[]){0x00}, 1, 0},
+  {0x3A, (uint8_t[]){0x55}, 1, 0},
+  {0x11, (uint8_t[]){0x00}, 0, 120},
+  {0xc4, (uint8_t[]){0x80}, 1, 0},
+  {0x44, (uint8_t[]){0x01, 0xD1}, 2, 0},
+  {0x35, (uint8_t[]){0x00}, 1, 0},
+  {0x53, (uint8_t[]){0x20}, 1, 10},
+  {0x63, (uint8_t[]){0xFF}, 1, 10},
+  {0x51, (uint8_t[]){0x00}, 1, 10},
+  {0x2A, (uint8_t[]){0x00, 0x16, 0x01, 0xAF}, 4, 0},
+  {0x2B, (uint8_t[]){0x00, 0x00, 0x01, 0xF5}, 4, 0},
+  {0x29, (uint8_t[]){0x00}, 0, 10},
+  {0x51, (uint8_t[]){0xFF}, 1, 0},
+};
+
+
+#define LCD_INIT_CMDS_COUNT (sizeof(lcd_init_cmds) / sizeof(lcd_init_cmds[0]))
+
+static struct esp32s3_co5300_dev_s g_co5300dev;
+
+#if TE_SYNC
+static volatile uint32_t g_te_isr_count;   /* TE edges seen by the ISR */
+static uint32_t g_te_wait_count;           /* frame waits since last report */
+static uint32_t g_te_timeout_count;        /* waits that hit the timeout */
+#endif
+
+#if GAPFREE_STREAM
+static uint8_t  *g_frame_buf;       /* full-frame byte-swapped DMA source (PSRAM) */
+static uint32_t  g_frame_buf_size;  /* allocated size in bytes */
+static bool      g_frame_buf_extram; /* true if buffer lives in PSRAM */
+#endif
+
+static struct lcd_dev_s g_co5300_lcddev =
+{
+  .getvideoinfo  = co5300_getvideoinfo,
+  .getplaneinfo  = co5300_getplaneinfo,
+  .getpower      = co5300_getpower,
+  .setpower      = co5300_setpower,
+  .getcontrast   = co5300_getcontrast,
+  .setcontrast   = co5300_setcontrast,
+  .setframerate  = co5300_setframerate,
+  .getframerate  = co5300_getframerate,
+  .getareaalign  = NULL,
+  .ioctl         = NULL,
+  .open          = NULL,
+  .close         = NULL,
+};
+
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static void lcd_reset(void)
+{
+  lcdinfo("LCD: Hardware reset\n");
+  esp32s3_gpiowrite(DISPLAY_RST_CO5300, false);
+  up_mdelay(10);
+  esp32s3_gpiowrite(DISPLAY_RST_CO5300, true);
+  up_mdelay(150);
+}
+
+static void lcd_write_cmd(struct qspi_dev_s *qspi, uint32_t cmd,
+                          uint8_t *data, uint8_t data_bytes)
+{
+  uint32_t addr = (cmd & 0xff) << 8;
+  uint8_t flags = QSPICMD_ADDRESS;
+
+  QSPI_LOCK(qspi, true);
+  esp32s3_qspibus_set_attr(qspi, 0, 1, 1);
+
+  if (data_bytes > 0)
+    {
+      flags |= QSPICMD_WRITEDATA;
+    }
+
+  struct qspi_cmdinfo_s cmdinfo =
+  {
+    .flags   = flags,
+    .addrlen = 3,
+    .cmd     = WRITE_CMD,
+    .buflen  = data_bytes,
+    .addr    = addr,
+    .buffer  = data,
+  };
+
+  QSPI_COMMAND(qspi, &cmdinfo);
+  QSPI_LOCK(qspi, false);
+}
+/* Copy RGB565 pixels from src (LVGL draw buffer, may live in PSRAM) into
+ * dst (internal, DMA-safe RAM) while swapping byte order in a SINGLE pass.
+ *
+ * This replaces the previous two-pass approach (memcpy() followed by an
+ * in-place byte swap), which touched every pixel twice.  Fusing copy+swap
+ * roughly halves the per-frame CPU memory traffic for color staging.
+ *
+ * Note: LVGL v9.1 has no global RGB565 byte-swap option, so the CO5300
+ * (which expects big-endian RGB565 on the wire) requires this swap on CPU.
+ */
+
+static void lcd_copy_swap_rgb565(uint8_t *dst, const uint8_t *src,
+                                 size_t size)
+{
+  uint16_t *d = (uint16_t *)dst;
+  const uint16_t *s = (const uint16_t *)src;
+  size_t n = size / 2;
+  for (size_t i = 0; i < n; i++)
+    {
+      d[i] = __builtin_bswap16(s[i]);
+    }
+}
+
+/* Write the CPU data cache back to PSRAM so the GDMA reads fresh pixels.
+ * The flushed region is cache-line (32B) aligned -- addr is 64B aligned and
+ * size is rounded up -- so the raw ROM writeback path is always safe.
+ */
+
+#if GAPFREE_STREAM
+static void co5300_cache_writeback(void *addr, uint32_t size)
+{
+  uint32_t autoload;
+
+  size = (size + 31u) & ~31u;
+  autoload = Cache_Suspend_DCache_Autoload();
+  rom_Cache_WriteBack_Addr((uint32_t)(uintptr_t)addr, size);
+  Cache_Resume_DCache_Autoload(autoload);
+}
+#endif
+
+#if TE_SYNC
+
+/* Tearing Effect (TE) synchronization.
+ *
+ * The CO5300 drives its TE line (wired to GPIO13) at the start of the
+ * panel's vertical blanking interval (enabled by init command 0x35=0x00).
+ * Waiting for that rising edge before streaming a new frame starts the QSPI
+ * write in sync with the panel's internal scan-out, removing the tearing
+ * seen during full-screen transitions.
+ */
+
+static int co5300_te_isr(int irq, FAR void *context, FAR void *arg)
+{
+  FAR struct esp32s3_co5300_dev_s *priv =
+    (FAR struct esp32s3_co5300_dev_s *)arg;
+  int val;
+
+  g_te_isr_count++;
+
+  /* Post at most once so the semaphore count never grows without bound */
+
+  if (nxsem_get_value(&priv->te_sem, &val) == OK && val <= 0)
+    {
+      nxsem_post(&priv->te_sem);
+    }
+
+  return OK;
+}
+
+static void co5300_wait_te(FAR struct esp32s3_co5300_dev_s *priv)
+{
+  int ret;
+
+  /* Drop any stale TE event so we block until the NEXT vblank edge */
+
+  while (nxsem_trywait(&priv->te_sem) == OK)
+    {
+    }
+
+  /* Wait for the next TE pulse, with a timeout so a missed edge can never
+   * stall the display pipeline.
+   */
+
+  ret = nxsem_tickwait(&priv->te_sem, MSEC2TICK(TE_WAIT_TIMEOUT_MS));
+
+#if TE_DIAG
+  if (ret == -ETIMEDOUT)
+    {
+      g_te_timeout_count++;
+    }
+
+  /* Report once per ~120 frames so you can confirm TE is actually firing.
+   * Healthy sync: isr grows ~1 per frame and timeouts stays 0.
+   * If timeouts == waits, the TE pin/edge is wrong (try FALLING / check wiring).
+   */
+
+  if (++g_te_wait_count >= 120)
+    {
+      syslog(LOG_INFO, "CO5300 TE: waits=%lu isr=%lu timeouts=%lu\n",
+             (unsigned long)g_te_wait_count,
+             (unsigned long)g_te_isr_count,
+             (unsigned long)g_te_timeout_count);
+      g_te_wait_count = 0;
+      g_te_isr_count = 0;
+      g_te_timeout_count = 0;
+    }
+#else
+  UNUSED(ret);
+#endif
+}
+
+#endif /* TE_SYNC */
+
+static void lcd_write_color(FAR struct esp32s3_co5300_dev_s *priv,
+                            FAR const uint8_t *color, uint32_t data_bytes)
+{
+  uint32_t offset = 0;
+  uint32_t remain = data_bytes;
+  bool first_chunk = true;
+  struct qspi_dev_s *qspi = priv->qspi;
+  FAR const uint8_t *staged = NULL;
+
+#if GAPFREE_STREAM
+  /* Stage the WHOLE frame (byte-swapped) into a DMA-source buffer BEFORE
+   * syncing to TE.  Once TE fires, every chunk is then streamed back to back
+   * with no CPU work in between, so the QSPI output never stalls and the
+   * panel scan-out is never briefly overtaken -- which is what produced the
+   * tearing lines at chunk boundaries in the upper half of the screen.
+   */
+
+  if (g_frame_buf != NULL && data_bytes <= g_frame_buf_size)
+    {
+      lcd_copy_swap_rgb565(g_frame_buf, color, data_bytes);
+
+      /* Flush CPU cache so the GDMA reads the freshly swapped pixels */
+
+      if (g_frame_buf_extram)
+        {
+          co5300_cache_writeback(g_frame_buf, data_bytes);
+        }
+
+      staged = g_frame_buf;
+    }
+#endif
+
+#if TE_SYNC
+  /* Sync the frame write to the panel's vblank to avoid tearing.  Done AFTER
+   * staging above so the post-TE stream is gap-free.
+   */
+
+  co5300_wait_te(priv);
+#endif
+
+  QSPI_LOCK(qspi, true);
+  esp32s3_qspibus_set_attr(qspi, 0, 1, 4);
+
+  while (remain > 0)
+    {
+      uint32_t chunk = remain;
+      if (chunk > LCD_QSPI_MAX_CHUNK)
+        {
+          chunk = LCD_QSPI_MAX_CHUNK;
+        }
+
+      FAR const uint8_t *send_buf;
+      if (staged != NULL)
+        {
+          /* Already swapped & cache-clean: stream directly, no CPU work */
+
+          send_buf = staged + offset;
+        }
+      else if (SWAP_RGB565)
+        {
+          /* Fallback: per-chunk copy + swap into internal DMA-safe RAM */
+
+          lcd_copy_swap_rgb565(priv->swap_buf, color + offset, chunk);
+          send_buf = priv->swap_buf;
+        }
+      else
+        {
+          send_buf = color + offset;
+        }
+
+      uint32_t addr = first_chunk ? 0x002c00 : 0x003c00;
+
+      struct qspi_meminfo_s meminfo =
+      {
+        .flags   = QSPIMEM_WRITE,
+        .addrlen = 3,
+        .dummies = 0,
+        .cmd     = WRITE_COLOR,
+        .addr    = addr,
+        .buflen  = chunk,
+        .buffer  = (FAR uint8_t *)send_buf,
+      };
+
+      int ret = QSPI_MEMORY(qspi, &meminfo);
+      if (ret < 0)
+        {
+          printf("ERROR: LCD: QSPI_MEMORY failed, offset=%" PRIu32
+                  " chunk=%" PRIu32 " ret=%d\n", offset, chunk, ret);
+          break;
+        }
+
+      offset += chunk;
+      remain -= chunk;
+      first_chunk = false;
+    }
+
+  QSPI_LOCK(qspi, false);
+}
+
+static void lcd_write_window_mem(FAR struct esp32s3_co5300_dev_s *priv,
+                                 int x_start, int y_start,
+                                 int x_end, int y_end,
+                                 FAR const uint8_t *color)
+{
+  /* x_end/y_end are EXCLUSIVE (original code convention).
+   * NuttX putarea uses INCLUSIVE coordinates, caller must convert.
+   */
+
+  if (x_start < 0 || y_start < 0 || x_end <= x_start || y_end <= y_start)
+    {
+      printf("CO5300: WARNING - invalid window coords: x[%d,%d) y[%d,%d)\n",
+             x_start, x_end, y_start, y_end);
+      return;
+    }
+
+  /* Clamp to display dimensions instead of silently dropping */
+  if (x_end > BSP_LCD_H_RES)
+    {
+      printf("CO5300: WARNING - x_end %d exceeds H_RES %d, clamping\n",
+             x_end, BSP_LCD_H_RES);
+      x_end = BSP_LCD_H_RES;
+    }
+
+  if (y_end > BSP_LCD_V_RES)
+    {
+      printf("CO5300: WARNING - y_end %d exceeds V_RES %d, clamping\n",
+             y_end, BSP_LCD_V_RES);
+      y_end = BSP_LCD_V_RES;
+    }
+
+  /* Re-check after clamping */
+  if (x_end <= x_start || y_end <= y_start)
+    {
+      return;
+    }
+
+  x_start += 0x16;
+  x_end   += 0x16;
+
+  lcd_write_cmd(priv->qspi, 0x2A,
+    (uint8_t[])
+    {
+      (x_start >> 8) & 0xFF,
+      x_start & 0xFF,
+      ((x_end - 1) >> 8) & 0xFF,
+      (x_end - 1) & 0xFF,
+    }, 4);
+
+  lcd_write_cmd(priv->qspi, 0x2B,
+    (uint8_t[])
+    {
+      (y_start >> 8) & 0xFF,
+      y_start & 0xFF,
+      ((y_end - 1) >> 8) & 0xFF,
+      (y_end - 1) & 0xFF,
+    }, 4);
+
+  size_t len = (size_t)(x_end - x_start) * (y_end - y_start) *
+               (BSP_LCD_BPP / 8);
+
+  lcd_write_color(priv, color, len);
+}
+
+static void lcd_init(struct qspi_dev_s *qspi)
+{
+  lcd_reset();
+
+  for (int i = 0; i < LCD_INIT_CMDS_COUNT; i++)
+    {
+      lcd_write_cmd(qspi, lcd_init_cmds[i].cmd,
+                    (uint8_t *)lcd_init_cmds[i].data,
+                    lcd_init_cmds[i].data_bytes);
+      up_mdelay(lcd_init_cmds[i].delay_ms);
+    }
+
+  up_mdelay(1);
+}
+
+static int co5300_getvideoinfo(FAR struct lcd_dev_s *dev,
+                               FAR struct fb_videoinfo_s *vinfo)
+{
+  DEBUGASSERT(dev && vinfo);
+  vinfo->fmt     = BSP_LCD_COLORFMT;
+  vinfo->xres    = BSP_LCD_H_RES;
+  vinfo->yres    = BSP_LCD_V_RES;
+  vinfo->nplanes = 1;
+  return OK;
+}
+
+static int co5300_getplaneinfo(FAR struct lcd_dev_s *dev,
+                               unsigned int planeno,
+                               FAR struct lcd_planeinfo_s *pinfo)
+{
+  DEBUGASSERT(dev && pinfo && planeno == 0);
+  pinfo->putrun  = co5300_putrun;
+  pinfo->putarea = co5300_putarea;
+  pinfo->buffer  = NULL;
+  pinfo->bpp     = BSP_LCD_BPP;
+  pinfo->dev     = dev;
+  return OK;
+}
+
+/* Global brightness level, used by setpower for wake-up restore */
+extern uint8_t brightness;
+
+static int co5300_setpower(FAR struct lcd_dev_s *dev, int power)
+{
+  FAR struct esp32s3_co5300_dev_s *priv =
+    (FAR struct esp32s3_co5300_dev_s *)dev;
+
+  DEBUGASSERT(dev);
+
+  if (power > 0)
+    {
+      /* Wake-up sequence: if display was off, we need to send Sleep Out
+       * first to ensure the panel exits low-power state, then wait the
+       * required delay before turning the display on.
+       */
+
+      if (priv->power == 0)
+        {
+          /* Send Sleep Out (0x11) to wake panel from low-power state */
+          lcd_write_cmd(priv->qspi, 0x11, NULL, 0);
+
+          /* CO5300 datasheet requires 120ms delay after Sleep Out */
+          up_mdelay(120);
+
+          /* Re-send brightness level after wake-up, otherwise panel
+           * may show at wrong brightness or appear blank.
+           */
+          lcd_write_cmd(priv->qspi, 0x51,
+                        (uint8_t[]){brightness > 0 ? brightness : 0xFF}, 1);
+          up_mdelay(10);
+        }
+
+      /* Display On (0x29) */
+      lcd_write_cmd(priv->qspi, 0x29, NULL, 0);
+      up_mdelay(10);
+      priv->power = 1;
+    }
+  else
+    {
+      /* Turn off display and enter sleep for lower power consumption.
+       * Sequence: Display Off (0x28) -> Sleep In (0x10).
+       * Sleep In puts the panel into low-power state.
+       */
+      lcd_write_cmd(priv->qspi, 0x28, NULL, 0);
+      up_mdelay(10);
+      lcd_write_cmd(priv->qspi, 0x10, NULL, 0);
+      priv->power = 0;
+    }
+
+  return OK;
+}
+
+static int co5300_getpower(FAR struct lcd_dev_s *dev)
+{
+  FAR struct esp32s3_co5300_dev_s *priv =
+    (FAR struct esp32s3_co5300_dev_s *)dev;
+
+  DEBUGASSERT(dev);
+  return priv->power;
+}
+
+
+uint8_t brightness = 0;
+
+#define co5300_display_brightness_level_0    0
+#define co5300_display_brightness_level_1    1
+#define co5300_display_brightness_level_2    2
+#define co5300_display_brightness_level_3    3
+#define co5300_display_brightness_level_4    4
+
+static int co5300_getcontrast(FAR struct lcd_dev_s *dev)
+{
+  if(brightness == 0x33)
+  {
+    return  co5300_display_brightness_level_0;  
+  }
+  else if(brightness == 0x66)
+  {
+    return  co5300_display_brightness_level_1;
+  }
+  else if(brightness == 0x99)
+  {
+    return  co5300_display_brightness_level_2;
+  }
+  else if(brightness == 0xCC)
+  {
+    return co5300_display_brightness_level_3;
+  }
+  else if(brightness == 0xFF)
+  {
+    return co5300_display_brightness_level_4;
+  }
+  else
+  {
+    return co5300_display_brightness_level_4;
+  } 
+}
+
+
+static int co5300_setcontrast(FAR struct lcd_dev_s *dev, unsigned int contrast)
+{
+  FAR struct esp32s3_co5300_dev_s *priv = (FAR struct esp32s3_co5300_dev_s *)dev;
+
+  if(contrast == co5300_display_brightness_level_0)
+  {
+    brightness = 0x33;   //20*255/100
+  }
+  else if(contrast == co5300_display_brightness_level_1)
+  {
+    brightness = 0x66;  // 40*255/100
+  }
+  else if(contrast == co5300_display_brightness_level_2)
+  {
+    brightness = 0x99;  //60*255/100
+  }
+  else if(contrast == co5300_display_brightness_level_3)
+  {
+    brightness = 0xCC;  //80*255/100
+  }
+  else if(contrast == co5300_display_brightness_level_4)
+  {
+    brightness = 0xFF;  //100*255/100
+  }
+  else
+  {
+    brightness = 0xFF;  //100*255/100
+  }
+
+  lcd_write_cmd(priv->qspi, 0x51,  (uint8_t[]){brightness}, 1);
+
+  return OK;
+}
