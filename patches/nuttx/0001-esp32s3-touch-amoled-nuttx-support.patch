+void axp2101_power_reset(void)
+{
+  static struct battery_charger_dev_s *g_axp2101_dev = NULL;
+  g_axp2101_dev = get_axp2101_dev();
+  int ret;
+  int retry;
+  for (retry = 0; retry < 3; retry++)
+    {
+      ret = axp2101_reset(g_axp2101_dev);
+      if (ret == OK)
+        {
+          syslog(LOG_INFO, "[AXP2101] power_reset: PMIC reset issued (try %d)\n",
+                 retry + 1);
+          return;  /* 成功，PMIC 即将断电，本函数不返回 */
+        }
+      syslog(LOG_ERR, "[AXP2101] power_reset: I2C reset failed (try %d, rc=%d)\n",
+             retry + 1, ret);
+      up_mdelay(10);  /* 10ms 后重试，应对 I2C 偶发抖动 */
+    }
+  syslog(LOG_ERR, "[AXP2101] power_reset: all 3 retries failed, PMIC not reset\n");
+}
