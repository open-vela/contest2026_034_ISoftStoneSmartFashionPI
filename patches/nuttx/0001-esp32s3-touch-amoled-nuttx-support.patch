+++ b/tools/convert_fonts_to_c.py
@@ -0,0 +1,175 @@
+#!/usr/bin/env python3
+"""
+Convert TTF fonts to embedded C arrays with optional subsetting.
+
+Usage (full font, no subset):
+    python3 convert_fonts_to_c.py \
+        -i vendor/watch/resource/font/assets \
+        -o vendor/watch/resource/font/generated \
+        --names-file vendor/watch/resource/font/font_src.inc
+
+Usage with subset:
+    python3 convert_fonts_to_c.py \
+        -i vendor/watch/resource/font/assets \
+        -o vendor/watch/resource/font/generated \
+        --names-file vendor/watch/resource/font/font_src.inc \
+        --subset-file charset.txt
+
+The subset-file should contain all characters you need (e.g. Chinese text).
+"""
+
+import os
+import sys
+import argparse
+import subprocess
+
+
+def parse_font_names(inc_path):
+    """Parse FONT_SRC(NAME) macros from .inc file."""
+    names = []
+    with open(inc_path, "r") as f:
+        for line in f:
+            line = line.strip()
+            if line.startswith("FONT_SRC(") and line.endswith(")"):
+                name = line[len("FONT_SRC("):-1].strip()
+                names.append(name)
+    return names
+
+
+def read_charset(path):
+    """Read charset file and return unique characters."""
+    chars = set()
+    with open(path, "r", encoding="utf-8") as f:
+        for line in f:
+            for ch in line.strip():
+                chars.add(ch)
+    # Always keep basic ASCII
+    for c in range(32, 127):
+        chars.add(chr(c))
+    return "".join(sorted(chars))
+
+
+def subset_font(ttf_path, output_path, charset):
+    """Subset TTF using fontTools."""
+    try:
+        from fontTools.subset import main as ft_subset_main
+    except ImportError:
+        print("[ERROR] fontTools not installed. Run: pip install fonttools")
+        sys.exit(1)
+
+    # Write charset to a temp file for fontTools
+    import tempfile
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False) as f:
+        f.write(charset)
+        charset_file = f.name
+
+    try:
+        args = [
+            ttf_path,
+            f"--text-file={charset_file}",
+            "--output-file=" + output_path,
+            "--recalc-bounds",
+            "--recalc-average-width",
+            "--recalc-max-context",
+            "--layout-features=*",
+            "--glyph-names",
+            "--symbol-cmap",
+            "--legacy-cmap",
+            "--notdef-glyph",
+            "--notdef-outline",
+            "--recommended-glyphs",
+            "--name-IDs=*",
+        ]
+        print(f"[SUBSET] {os.path.basename(ttf_path)} -> {os.path.basename(output_path)}")
+        ft_subset_main(args)
+    finally:
+        os.unlink(charset_file)
+
+
+def ttf_to_c_array(ttf_path, name, output_dir):
+    """Convert TTF file to C array (xxd-style)."""
+    with open(ttf_path, "rb") as f:
+        data = f.read()
+
+    size = len(data)
+    if size == 0:
+        print(f"[ERROR] TTF file is empty: {ttf_path}")
+        return
+
+    # Generate header
+    h_path = os.path.join(output_dir, f"{name}.h")
+    with open(h_path, "w") as f:
+        f.write(f"/* Auto-generated from {os.path.basename(ttf_path)}\n")
+        f.write(" * Do not edit manually.\n")
+        f.write(" */\n\n")
+        f.write("#ifndef __{}_H__\n".format(name.upper()))
+        f.write("#define __{}_H__\n\n".format(name.upper()))
+        f.write("#include <stdint.h>\n\n")
+        f.write(f"#define {name}_ttf_size {size}\n")
+        f.write(f"extern const uint8_t {name}_ttf_data[{size}];\n\n")
+        f.write("#endif /* __{}_H__ */\n".format(name.upper()))
+
+    # Generate C source
+    c_path = os.path.join(output_dir, f"{name}.c")
+    with open(c_path, "w") as f:
+        f.write(f"/* Auto-generated from {os.path.basename(ttf_path)}\n")
+        f.write(" * Do not edit manually.\n")
+        f.write(" */\n\n")
+        f.write(f'#include "{name}.h"\n\n')
+        f.write(f"#define {name}_ttf_size {size}\n\n")
+        f.write(f"const uint8_t {name}_ttf_data[{size}] = {{\n")
+        for i in range(0, size, 16):
+            row = data[i:i+16]
+            hex_str = ", ".join(f"0x{b:02X}" for b in row)
+            f.write(f"    {hex_str},\n")
+        f.write("};\n")
+
+    print(f"[OK] Generated {h_path} ({size} bytes)")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Convert TTF fonts to C arrays")
+    parser.add_argument("-i", "--input", required=True, help="Directory containing .ttf files")
+    parser.add_argument("-o", "--output", required=True, help="Output directory")
+    parser.add_argument("--names-file", required=True, help=".inc file with FONT_SRC() macros")
+    parser.add_argument("--subset-file", default=None, help="Text file with characters to keep")
+    args = parser.parse_args()
+
+    os.makedirs(args.output, exist_ok=True)
+    names = parse_font_names(args.names_file)
+    print(f"[INFO] Found {len(names)} font definitions in {args.names_file}")
+
+    charset = None
+    if args.subset_file:
+        charset = read_charset(args.subset_file)
+        print(f"[INFO] Subset charset: {len(charset)} unique characters")
+
+    for name in names:
+        ttf_name = name.replace("_", "-") + ".ttf"
+        ttf_path = os.path.join(args.input, ttf_name)
+        if not os.path.exists(ttf_path):
+            # Try original name
+            ttf_name = name + ".ttf"
+            ttf_path = os.path.join(args.input, ttf_name)
+
+        if not os.path.exists(ttf_path):
+            print(f"[WARN] TTF not found: {ttf_path}")
+            continue
+
+        if charset:
+            import tempfile
+            with tempfile.NamedTemporaryFile(suffix=".ttf", delete=False) as tmp:
+                subset_path = tmp.name
+            try:
+                subset_font(ttf_path, subset_path, charset)
+                ttf_to_c_array(subset_path, name, args.output)
+            finally:
+                os.unlink(subset_path)
+        else:
+            ttf_to_c_array(ttf_path, name, args.output)
+
+    print("[OK] All fonts converted successfully!")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/convert_lvgl_assets.py b/tools/convert_lvgl_assets.py
new file mode 100644
index 00000000000..8d6ab5a8a82
--- /dev/null
+++ b/tools/convert_lvgl_assets.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""
+Convert PNG images to LVGL v9 RGB565 C arrays.
+
+Usage:
+    python3 convert_lvgl_assets.py \
+        -i vendor/watch/resource/image \
+        -o vendor/watch/resource/image/generated \
+        --names-file vendor/watch/resource/image/img_src.inc \
+        --cf RGB565 --align 4
+"""
+
+import os
+import sys
+import subprocess
+import argparse
+import glob
+from pathlib import Path
+
+LVGL_IMAGE_PY = os.path.join(
+    os.path.dirname(os.path.abspath(__file__)),
+    "..", "..", "apps", "graphics", "lvgl", "lvgl", "scripts", "LVGLImage.py"
+)
+
+
+def parse_img_names(inc_path):
+    """Parse IMG_DEF(NAME) macros from .inc file."""
+    names = []
+    with open(inc_path, "r") as f:
+        for line in f:
+            line = line.strip()
+            if line.startswith("IMG_DEF(") and line.endswith(")"):
+                name = line[len("IMG_DEF("):-1].strip()
+                names.append(name)
+    return names
+
+
+def find_png(image_dir, name):
+    """Recursively search for NAME.png under image_dir."""
+    pattern = os.path.join(image_dir, "**", f"{name}.png")
+    matches = glob.glob(pattern, recursive=True)
+    if matches:
+        return matches[0]
+    return None
+
+
+def generate_assets(image_dir, output_dir, names, cf, align):
+    """Generate C arrays for all named PNGs."""
+    os.makedirs(output_dir, exist_ok=True)
+
+    for name in names:
+        png_path = find_png(image_dir, name)
+        if not png_path:
+            print(f"[WARN] PNG not found: {name}.png")
+            continue
+
+        cmd = [
+            sys.executable, LVGL_IMAGE_PY,
+            "--ofmt", "C",
+            "--cf", cf,
+            "--align", str(align),
+            "-o", output_dir,
+            png_path
+        ]
+        print(f"[GEN] {name}.png -> {output_dir}/{name}.c")
+        subprocess.run(cmd, check=True)
+
+
+def generate_header(output_dir, names):
+    """Generate lvgl_assets.h with LV_IMAGE_DECLARE for all assets."""
+    h_path = os.path.join(output_dir, "lvgl_assets.h")
+    with open(h_path, "w") as f:
+        f.write("/* Auto-generated by convert_lvgl_assets.py.\n")
+        f.write(" * Do not edit manually.\n")
+        f.write(" */\n\n")
+        f.write("#ifndef LVGL_ASSETS_H\n")
+        f.write("#define LVGL_ASSETS_H\n\n")
+        f.write('#include "lvgl/lvgl.h"\n\n')
+        f.write("#ifdef __cplusplus\n")
+        f.write('extern "C" {\n')
+        f.write("#endif\n\n")
+        for name in names:
+            f.write(f"LV_IMAGE_DECLARE({name});\n")
+        f.write("\n#ifdef __cplusplus\n")
+        f.write("}\n")
+        f.write("#endif\n\n")
+        f.write("#endif /* LVGL_ASSETS_H */\n")
+    print(f"[OK] Header generated: {h_path}")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Convert PNGs to LVGL C arrays")
+    parser.add_argument("-i", "--input", required=True, help="Image root directory")
+    parser.add_argument("-o", "--output", required=True, help="Output directory for C arrays")
+    parser.add_argument("--names-file", required=True, help=".inc file with IMG_DEF() macros")
+    parser.add_argument("--cf", default="RGB565", help="Color format (default: RGB565)")
+    parser.add_argument("--align", type=int, default=4, help="Stride alignment (default: 4)")
+    args = parser.parse_args()
+
+    names = parse_img_names(args.names_file)
+    print(f"[INFO] Found {len(names)} image definitions in {args.names_file}")
+
+    generate_assets(args.input, args.output, names, args.cf, args.align)
+    generate_header(args.output, names)
+
+    print("[OK] All assets converted successfully!")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/convert_power_assets.py b/tools/convert_power_assets.py
new file mode 100644
index 00000000000..2ac6e37ec2f
--- /dev/null
+++ b/tools/convert_power_assets.py
@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+"""
+Convert power_jpg/*.jpg and power_png/*.png to embedded C arrays with lv_image_dsc_t.
+This eliminates the need for LittleFS filesystem access for boot animation images.
+"""
+
+import os
+import sys
+import struct
+import glob
+import argparse
+
+# LVGL header magic number
+LV_IMAGE_HEADER_MAGIC = 0x19
+
+# Color formats from lv_color_format_t
+LV_COLOR_FORMAT_RAW = 0x01      # Used by tjpgd decoder
+LV_COLOR_FORMAT_ARGB8888 = 0x10 # Used by lodepng decoder
+
+
+def parse_jpg_size(data):
+    """Parse width and height from JPG SOF0/SOF2 marker."""
+    i = 0
+    while i < len(data) - 1:
+        if data[i] == 0xFF:
+            marker = data[i + 1]
+            # Skip padding
+            if marker == 0x00:
+                i += 2
+                continue
+            # SOF0, SOF1, SOF2 (baseline, extended sequential, progressive)
+            if marker in (0xC0, 0xC1, 0xC2):
+                if i + 9 < len(data):
+                    h = struct.unpack(">H", data[i + 5:i + 7])[0]
+                    w = struct.unpack(">H", data[i + 7:i + 9])[0]
+                    return w, h
+            # Skip marker segment
+            if marker != 0xD8 and marker != 0xD9 and i + 3 < len(data):
+                seg_len = struct.unpack(">H", data[i + 2:i + 4])[0]
+                i += 2 + seg_len
+                continue
+        i += 1
+    return 0, 0
+
+
+def parse_png_size(data):
+    """Parse width and height from PNG IHDR chunk."""
+    if len(data) < 24:
+        return 0, 0
+    # Offset 16-19: width (big-endian)
+    # Offset 20-23: height (big-endian)
+    w = struct.unpack(">I", data[16:20])[0]
+    h = struct.unpack(">I", data[20:24])[0]
+    return w, h
+
+
+def bytes_to_c_array(name, data):
+    """Convert bytes to C uint8_t array."""
+    lines = []
+    lines.append(f"const uint8_t {name}_data[{len(data)}] = {{")
+    row = []
+    for i, b in enumerate(data):
+        row.append(f"0x{b:02X}")
+        if len(row) == 16:
+            lines.append("    " + ", ".join(row) + ",")
+            row = []
+    if row:
+        lines.append("    " + ", ".join(row) + ",")
+    lines.append("};")
+    return "\n".join(lines)
+
+
+def generate_image_dsc(name, w, h, cf, data_name, data_size):
+    """Generate lv_image_dsc_t for the image."""
+    # stride: for RAW (JPG decoder outputs RGB888 stride = w * 3)
+    # for ARGB8888 (PNG decoder outputs ARGB8888 stride = w * 4)
+    if cf == LV_COLOR_FORMAT_RAW:
+        stride = w * 3
+    elif cf == LV_COLOR_FORMAT_ARGB8888:
+        stride = w * 4
+    else:
+        stride = 0
+
+    return f"""const lv_image_dsc_t {name} = {{
+    .header = {{
+        .magic = {LV_IMAGE_HEADER_MAGIC},
+        .cf = {cf},
+        .flags = 0,
+        .w = {w},
+        .h = {h},
+        .stride = {stride},
+        .reserved_2 = 0,
+    }},
+    .data_size = {data_size},
+    .data = {data_name},
+    .reserved = NULL,
+    .reserved_2 = NULL,
+}};"""
+
+
+def process_dir(src_dir, out_dir, out_name, ext, cf, parser):
+    """Process all images in a directory and generate C/H files."""
+    os.makedirs(out_dir, exist_ok=True)
+
+    files = sorted(glob.glob(os.path.join(src_dir, f"*.{ext}")))
+    if not files:
+        print(f"Warning: no .{ext} files found in {src_dir}")
+        return [], []
+
+    c_lines = [
+        f'/* Auto-generated from {src_dir} */',
+        f'/* Do not edit manually. */',
+        '',
+        '#include "lvgl/lvgl.h"',
+        '',
+    ]
+
+    guard = out_name.upper()
+    h_lines = [
+        f'/* Auto-generated from {src_dir} */',
+        f'/* Do not edit manually. */',
+        '',
+        f'#ifndef __{guard}_H__',
+        f'#define __{guard}_H__',
+        '',
+        '#include "lvgl/lvgl.h"',
+        '',
+    ]
+
+    declarations = []
+
+    # Use source directory name as prefix to avoid name collisions
+    dir_prefix = os.path.basename(os.path.normpath(src_dir))
+    inc_lines = []
+
+    for fpath in files:
+        basename = os.path.splitext(os.path.basename(fpath))[0]
+        var_name = f"{dir_prefix}_{basename}".replace("-", "_").replace(".", "_")
+
+        with open(fpath, "rb") as f:
+            data = f.read()
+
+        w, h = parser(data)
+        if w == 0 or h == 0:
+            print(f"Warning: failed to parse size for {fpath}, using 0,0")
+
+        c_lines.append(bytes_to_c_array(var_name, data))
+        c_lines.append("")
+        c_lines.append(generate_image_dsc(
+            var_name + "_dsc",
+            w, h, cf,
+            var_name + "_data",
+            len(data)
+        ))
+        c_lines.append("")
+
+        declarations.append(f"extern const lv_image_dsc_t {var_name}_dsc;")
+        inc_lines.append(f"IMG_DEF({var_name})")
+
+    h_lines.extend(declarations)
+    h_lines.extend([
+        '',
+        f'#endif /* __{guard}_H__ */',
+        '',
+    ])
+
+    c_path = os.path.join(out_dir, f"{out_name}.c")
+    h_path = os.path.join(out_dir, f"{out_name}.h")
+
+    with open(c_path, "w") as f:
+        f.write("\n".join(c_lines))
+    with open(h_path, "w") as f:
+        f.write("\n".join(h_lines))
+
+    # Generate .inc file for resource.c
+    inc_name = "img_jpg_src.inc" if ext == "jpg" else "power_img_src.inc"
+    inc_path = os.path.join(src_dir, inc_name)
+    with open(inc_path, "w") as f:
+        f.write("\n".join(inc_lines))
+        f.write("\n")
+
+    print(f"Generated {len(files)} images -> {c_path}, {h_path}, {inc_path}")
+    return c_path, h_path
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Convert power animation images to C arrays")
+    parser.add_argument("-r", "--resource-dir", required=True,
+                        help="Path to vendor/watch/resource directory")
+    args = parser.parse_args()
+
+    base_dir = args.resource_dir
+
+    # Process power_jpg
+    process_dir(
+        src_dir=os.path.join(base_dir, "power_jpg"),
+        out_dir=os.path.join(base_dir, "power_jpg", "generated"),
+        out_name="power_jpg_assets",
+        ext="jpg",
+        cf=LV_COLOR_FORMAT_RAW,
+        parser=parse_jpg_size,
+    )
+
+    # Process power_png
+    process_dir(
+        src_dir=os.path.join(base_dir, "power_png"),
+        out_dir=os.path.join(base_dir, "power_png", "generated"),
+        out_name="power_png_assets",
+        ext="png",
+        cf=LV_COLOR_FORMAT_ARGB8888,
+        parser=parse_png_size,
+    )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/flash_esp32s3.sh b/tools/flash_esp32s3.sh
new file mode 100755
index 00000000000..87a7a9ec283
--- /dev/null
+++ b/tools/flash_esp32s3.sh
@@ -0,0 +1,441 @@
+#!/bin/bash
+#
+# flash_esp32s3.sh - ESP32-S3 统一编译/打包/烧录脚本
+#
+# 用法:
+#   ./flash_esp32s3.sh              默认: 编译 NuttX 并刷写固件
+#   ./flash_esp32s3.sh -a           编译 + 打包 LittleFS + 刷写全部
+#   ./flash_esp32s3.sh -p           只打包 LittleFS 镜像
+#   ./flash_esp32s3.sh -f           打包并刷写 LittleFS 镜像
+#   ./flash_esp32s3.sh -n           只编译 NuttX，不刷机
+#   ./flash_esp32s3.sh -s           跳过编译，直接刷写已有固件
+#   ./flash_esp32s3.sh -c           make clean 后编译
+#   ./flash_esp32s3.sh -P /dev/ttyUSB0 -b 460800   指定串口和波特率
+#
+
+set -e
+
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+# 智能检测项目根目录:
+#   如果脚本在 <root>/nuttx/tools/ 下, 则项目根目录为脚本目录的上两级
+#   如果脚本在 <root>/ 下 (通过软链接调用), 则 SCRIPT_DIR 即为项目根目录
+if [ -d "${SCRIPT_DIR}/nuttx" ] && [ -d "${SCRIPT_DIR}/vendor" ]; then
+    PROJECT_ROOT="${SCRIPT_DIR}"
+elif [ -d "${SCRIPT_DIR}/../../vendor" ]; then
+    PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+else
+    echo "[ERROR] 无法自动检测项目根目录, SCRIPT_DIR=${SCRIPT_DIR}"
+    exit 1
+fi
+NUTTX_DIR="${PROJECT_ROOT}/nuttx"
+
+# 默认参数
+PORT="/dev/ttyACM0"
+BAUD="921600"
+ACTION="build_flash"   # build_flash | pack | flash_littlefs | flash_all | build_only | clean_build
+FORCE_PACK=0
+SKIP_PROMPT=0
+
+# LittleFS 参数
+BLOCK_SIZE=4096
+READ_SIZE=1024
+PROG_SIZE=1024
+
+# 素材目录
+RES_DIR="${PROJECT_ROOT}/vendor/watch/resource"
+TMP_DIR="${PROJECT_ROOT}/.tmp_littlefs_pack"
+IMG_FILE="${PROJECT_ROOT}/littlefs_watch.img"
+PACK_PY="${PROJECT_ROOT}/nuttx/tools/pack_littlefs.py"
+
+############################################################################
+# Helper functions
+############################################################################
+
+usage() {
+    cat << EOF
+Usage: $(basename "$0") [OPTIONS]
+
+ESP32-S3 统一编译/打包/烧录脚本
+
+Options:
+  -a, --flash-all       编译 NuttX + 打包 LittleFS + 刷写全部 (固件+素材)
+  -p, --pack-only       只打包 LittleFS 镜像，不烧录
+  -f, --flash-littlefs  打包并刷写 LittleFS 镜像
+  -C, --convert-assets  转换 PNG/TTF 素材为 C 数组（手动触发）
+  -s, --skip-build      跳过编译，直接刷写已有 nuttx.bin 固件
+  -n, --build-only      只编译 NuttX，不刷机
+  -c, --clean-build     make clean 后重新编译
+  -F, --force           强制重新生成 LittleFS 镜像
+  -P, --port <port>     串口设备 (默认: ${PORT})
+  -b, --baud <baud>     烧录波特率 (默认: ${BAUD})
+  -y, --yes             跳过确认提示
+  -h, --help            显示本帮助
+
+Examples:
+  $(basename "$0")                    # 编译并刷写固件
+  $(basename "$0") -s                 # 跳过编译，直接刷写已有固件
+  $(basename "$0") -a                 # 全量编译+打包+烧录
+  $(basename "$0") -p                 # 只打包 LittleFS 镜像
+  $(basename "$0") -C                 # 手动转换素材为 C 数组
+  $(basename "$0") -aC                # 转换素材 + 全量编译烧录
+  $(basename "$0") -f -P /dev/ttyUSB0 # 打包并烧录素材到指定串口
+  $(basename "$0") -c -a              # 清理后全量编译烧录
+
+EOF
+    exit 0
+}
+
+log_info()  { echo -e "\033[36m[INFO]\033[0m  $*"; }
+log_warn()  { echo -e "\033[33m[WARN]\033[0m  $*"; }
+log_error() { echo -e "\033[31m[ERROR]\033[0m $*"; }
+log_ok()    { echo -e "\033[32m[OK]\033[0m   $*"; }
+
+confirm() {
+    if [ "$SKIP_PROMPT" -eq 1 ]; then
+        return 0
+    fi
+    # 非交互式终端自动确认
+    if [ ! -t 0 ]; then
+        return 0
+    fi
+    read -rp "$1 [Y/n] " ans
+    case "$ans" in
+        [Nn]*) return 1 ;;
+        *) return 0 ;;
+    esac
+}
+
+read_mtd_config() {
+    # 优先读取 defconfig（用户维护的源配置），因为 .config 可能还没同步
+    local defconfig="${PROJECT_ROOT}/vendor/espressif/boards/esp32s3/esp32s3-touch-amoled/configs/openvela/defconfig"
+    local dotconfig="${NUTTX_DIR}/.config"
+    local config_file=""
+
+    if [ -f "$defconfig" ] && grep -q "CONFIG_ESP32S3_STORAGE_MTD_OFFSET=" "$defconfig" 2>/dev/null; then
+        config_file="$defconfig"
+    elif [ -f "$dotconfig" ] && grep -q "CONFIG_ESP32S3_STORAGE_MTD_OFFSET=" "$dotconfig" 2>/dev/null; then
+        config_file="$dotconfig"
+    fi
+
+    if [ -n "$config_file" ]; then
+        MTD_OFFSET=$(grep "CONFIG_ESP32S3_STORAGE_MTD_OFFSET=" "$config_file" | head -1 | cut -d'=' -f2 | tr -d '"')
+        MTD_SIZE=$(grep "CONFIG_ESP32S3_STORAGE_MTD_SIZE=" "$config_file" | head -1 | cut -d'=' -f2 | tr -d '"')
+        log_info "读取 MTD 配置: $config_file"
+    else
+        MTD_OFFSET="0x1210000"
+        MTD_SIZE="0xDF0000"
+        log_warn "未找到 MTD 配置，使用默认值"
+    fi
+
+    FS_SIZE=$(printf "%d" "${MTD_SIZE}")
+    BLOCK_COUNT=$((FS_SIZE / BLOCK_SIZE))
+}
+
+check_esptool() {
+    if command -v esptool.py &> /dev/null; then
+        ESPTOOL="esptool.py"
+    elif command -v esptool &> /dev/null; then
+        ESPTOOL="esptool"
+    else
+        log_error "未找到 esptool.py / esptool"
+        exit 1
+    fi
+}
+
+check_littlefs_python() {
+    if ! python3 -c "import littlefs" 2>/dev/null; then
+        log_error "需要安装 littlefs-python"
+        log_info "  pip3 install littlefs-python"
+        exit 1
+    fi
+}
+
+############################################################################
+# Actions
+############################################################################
+
+action_build_nuttx() {
+    log_info "编译 NuttX..."
+    cd "${NUTTX_DIR}"
+
+    # 确保 bootloader/partition table 已复制
+    if [ -f "${NUTTX_DIR}/version/esp32s3_watch/bootloader_bin_10MB/bootloader-esp32s3.bin" ]; then
+        cp "${NUTTX_DIR}/version/esp32s3_watch/bootloader_bin_10MB/bootloader-esp32s3.bin" .
+        cp "${NUTTX_DIR}/version/esp32s3_watch/bootloader_bin_10MB/partition-table-esp32s3.bin" .
+        log_info "已复制 10MB bootloader/partition-table"
+    fi
+
+    # 如果配置不存在（首次或被 distclean 清理），先执行配置脚本
+    if [ ! -f "${NUTTX_DIR}/.config" ]; then
+        log_warn "NuttX 配置不存在，执行首次配置..."
+        cd "${PROJECT_ROOT}"
+        local build_sh="${PROJECT_ROOT}/build.sh"
+        if [ -x "${build_sh}" ]; then
+            "${build_sh}" vendor/espressif/boards/esp32s3/esp32s3-touch-amoled/configs/openvela -j$(nproc)
+            log_ok "首次配置并编译完成"
+            return 0
+        else
+            log_error "找不到 build.sh: ${build_sh}"
+            exit 1
+        fi
+    fi
+
+    if [ "$ACTION" == "clean_build" ]; then
+        log_info "执行 make clean..."
+        make clean
+        # 删除应用层 .depend 文件，避免新增源文件后 Makefile 变更未被重新扫描
+        find "${PROJECT_ROOT}/apps" -name ".depend" -delete 2>/dev/null || true
+        log_info "已清理 apps/.depend 缓存"
+    fi
+
+    log_info "同步配置 (make oldconfig)..."
+    yes "" | make oldconfig 2>/dev/null || make oldconfig
+
+    make -j$(nproc)
+    log_ok "NuttX 编译完成"
+}
+
+action_flash_nuttx() {
+    log_info "刷写 NuttX 固件..."
+    cd "${NUTTX_DIR}"
+    sudo chmod 777 "${PORT}" 2>/dev/null || true
+    make flash ESPTOOL_PORT="${PORT}" ESPTOOL_BINDIR=./ -j$(nproc)
+    log_ok "NuttX 固件刷写完成"
+}
+
+action_convert_assets() {
+    log_info "=========================="
+    log_info "转换素材为 C 数组"
+    log_info "=========================="
+
+    local assets_gen_dir="${PROJECT_ROOT}/vendor/watch/resource/image/generated"
+    local assets_names="${PROJECT_ROOT}/vendor/watch/resource/image/img_src.inc"
+    local font_gen_dir="${PROJECT_ROOT}/vendor/watch/resource/font/generated"
+    local convert_script="${PROJECT_ROOT}/nuttx/tools/convert_lvgl_assets.py"
+    local convert_font_script="${PROJECT_ROOT}/nuttx/tools/convert_fonts_to_c.py"
+
+    # PNG -> C arrays
+    log_info "[1/2] 转换 PNG 图片为 LVGL C 数组..."
+    if [ -f "${convert_script}" ]; then
+        mkdir -p "${assets_gen_dir}"
+        python3 "${convert_script}" \
+            -i "${PROJECT_ROOT}/vendor/watch/resource/image" \
+            -o "${assets_gen_dir}" \
+            --names-file "${assets_names}" \
+            --cf RGB565 --align 4
+        log_ok "图片 C 数组生成完成: ${assets_gen_dir}"
+    else
+        log_warn "转换脚本不存在: ${convert_script}，跳过 PNG 转换"
+    fi
+
+    # TTF -> C arrays
+    log_info "[2/3] 转换 TTF 字体为 C 数组..."
+    if [ -f "${convert_font_script}" ]; then
+        mkdir -p "${font_gen_dir}"
+        python3 "${convert_font_script}" \
+            -i "${PROJECT_ROOT}/vendor/watch/resource/font/assets" \
+            -o "${font_gen_dir}" \
+            --names-file "${PROJECT_ROOT}/vendor/watch/resource/font/font_src.inc"
+        log_ok "字体 C 数组生成完成: ${font_gen_dir}"
+    else
+        log_warn "字体转换脚本不存在: ${convert_font_script}，跳过 TTF 转换"
+    fi
+
+    # Power animation -> C arrays
+    log_info "[3/3] 转换开机动画为 C 数组..."
+    python3 "${PROJECT_ROOT}/nuttx/tools/convert_power_assets.py" -r "${PROJECT_ROOT}/vendor/watch/resource"
+    log_ok "开机动画 C 数组生成完成"
+
+    log_ok "素材转换全部完成！"
+}
+
+action_pack_littlefs() {
+    log_info "打包 LittleFS 镜像..."
+
+    read_mtd_config
+    check_littlefs_python
+
+    log_info "配置: MTD_OFFSET=${MTD_OFFSET}, MTD_SIZE=${MTD_SIZE} (${FS_SIZE} bytes), BLOCK_COUNT=${BLOCK_COUNT}"
+
+    # 清理/创建临时目录
+    if [ -d "${TMP_DIR}" ] && [ "$FORCE_PACK" -eq 1 ]; then
+        rm -rf "${TMP_DIR}"
+    fi
+    if [ -f "${IMG_FILE}" ] && [ "$FORCE_PACK" -eq 1 ]; then
+        rm -f "${IMG_FILE}"
+    fi
+
+    mkdir -p "${TMP_DIR}"
+    mkdir -p "${TMP_DIR}/FONT"
+    mkdir -p "${TMP_DIR}/power_jpg"
+    mkdir -p "${TMP_DIR}/power_png"
+
+    # 复制字体（从 assets，不复制已嵌入的 C 数组字体，除非用户需要）
+    log_info "[1/3] 复制字体文件..."
+    if [ -d "${RES_DIR}/font/assets" ]; then
+        cp "${RES_DIR}/font/assets/"*.ttf "${TMP_DIR}/FONT/" 2>/dev/null || true
+        log_ok "已复制 $(ls "${TMP_DIR}/FONT/" 2>/dev/null | wc -l) 个字体文件"
+    else
+        log_warn "找不到字体目录 ${RES_DIR}/font/assets"
+    fi
+
+    # 开机动画已嵌入固件（C数组），无需复制到 LittleFS
+    # log_info "[2/3] 复制开机动画..."
+    # if [ -d "${RES_DIR}/power_jpg" ]; then
+    #     cp "${RES_DIR}/power_jpg/"*.jpg "${TMP_DIR}/power_jpg/" 2>/dev/null || true
+    #     log_ok "已复制 $(ls "${TMP_DIR}/power_jpg/" 2>/dev/null | wc -l) 个 jpg 文件"
+    # fi
+    # if [ -d "${RES_DIR}/power_png" ]; then
+    #     cp "${RES_DIR}/power_png/"*.png "${TMP_DIR}/power_png/" 2>/dev/null || true
+    #     log_ok "已复制 $(ls "${TMP_DIR}/power_png/" 2>/dev/null | wc -l) 个 png 文件"
+    # fi
+
+    # 生成镜像
+    log_info "[3/3] 生成 LittleFS 镜像..."
+    python3 "${PACK_PY}" \
+        -c "${TMP_DIR}" \
+        -o "${IMG_FILE}" \
+        -b "${BLOCK_SIZE}" \
+        -s "${BLOCK_COUNT}" \
+        -r "${READ_SIZE}" \
+        -p "${PROG_SIZE}"
+
+    log_ok "镜像生成成功: ${IMG_FILE} ($(ls -lh "${IMG_FILE}" | awk '{print $5}'))"
+}
+
+action_flash_littlefs() {
+    log_info "刷写 LittleFS 镜像..."
+    read_mtd_config
+    check_esptool
+
+    if [ ! -f "${IMG_FILE}" ]; then
+        log_error "找不到镜像文件: ${IMG_FILE}"
+        log_info "请先执行: $(basename "$0") -p"
+        exit 1
+    fi
+
+    sudo chmod 777 "${PORT}" 2>/dev/null || true
+
+    "${ESPTOOL}" --chip esp32s3 --port "${PORT}" --baud "${BAUD}" \
+        write_flash --compress "${MTD_OFFSET}" "${IMG_FILE}"
+
+    log_ok "LittleFS 镜像刷写完成 (偏移: ${MTD_OFFSET})"
+}
+
+action_flash_all() {
+    log_info "=========================="
+    log_info "全量编译 + 打包 + 烧录"
+    log_info "=========================="
+    action_build_nuttx
+    action_pack_littlefs
+
+    log_info "编译和打包完成，准备刷写..."
+    if ! confirm "即将刷写 NuttX 固件和 LittleFS 镜像，确认继续?"; then
+        log_info "已取消，镜像保留在: ${IMG_FILE}"
+        exit 0
+    fi
+
+    action_flash_nuttx
+    action_flash_littlefs
+    log_ok "全部完成！"
+}
+
+############################################################################
+# Parse arguments
+############################################################################
+
+while [[ $# -gt 0 ]]; do
+    case $1 in
+        -a|--flash-all)
+            ACTION="flash_all"
+            shift
+            ;;
+        -p|--pack-only)
+            ACTION="pack"
+            shift
+            ;;
+        -f|--flash-littlefs)
+            ACTION="flash_littlefs"
+            shift
+            ;;
+        -C|--convert-assets)
+            ACTION="convert_assets"
+            shift
+            ;;
+        -s|--skip-build)
+            ACTION="flash_only"
+            shift
+            ;;
+        -n|--build-only)
+            ACTION="build_only"
+            shift
+            ;;
+        -c|--clean-build)
+            ACTION="clean_build"
+            shift
+            ;;
+        -F|--force)
+            FORCE_PACK=1
+            shift
+            ;;
+        -P|--port)
+            PORT="$2"
+            shift 2
+            ;;
+        -b|--baud)
+            BAUD="$2"
+            shift 2
+            ;;
+        -y|--yes)
+            SKIP_PROMPT=1
+            shift
+            ;;
+        -h|--help)
+            usage
+            ;;
+        *)
+            log_error "未知参数: $1"
+            usage
+            ;;
+    esac
+done
+
+############################################################################
+# Main
+############################################################################
+
+case "$ACTION" in
+    flash_only)
+        action_flash_nuttx
+        ;;
+    build_flash)
+        action_build_nuttx
+        action_flash_nuttx
+        ;;
+    clean_build)
+        action_build_nuttx
+        action_flash_nuttx
+        ;;
+    build_only)
+        action_build_nuttx
+        ;;
+    pack)
+        action_pack_littlefs
+        ;;
+    flash_littlefs)
+        action_pack_littlefs
+        action_flash_littlefs
+        ;;
+    convert_assets)
+        action_convert_assets
+        ;;
+    flash_all)
+        action_flash_all
+        ;;
+    *)
+        log_error "未知动作: $ACTION"
+        exit 1
+        ;;
+esac
