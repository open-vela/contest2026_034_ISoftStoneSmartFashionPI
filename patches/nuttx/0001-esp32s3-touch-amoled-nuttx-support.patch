+/****************************************************************************
+ * Name: axp2101_operate
+ *
+ * Description:
+ *   Do miscellaneous battery ioctl()
+ *
+ ****************************************************************************/
+
+
+static int axp2101_operate(FAR struct battery_charger_dev_s *dev, uintptr_t param)
+{
+  uint8_t axp2101_soc = 0;
+  uint8_t poweron_status = 0;
+  uint8_t poweroff_status = 0;
+  uint8_t pmu_status = 0x0;
+  uint8_t pmu_charge_status = 0x0;
+
+  switch (param)
+    {
+        case AXP2101_BATTERY_IOCTL_POWEROFF:
+            return axp2101_poweroff(dev);  // 关机   0
+
+        case AXP2101_BATTERY_IOCTL_RESET:
+            return axp2101_reset(dev);      // 重启   1
+
+        case AXP2101_BATTERY_IOCTL_GET_SOC:
+            axp2101_get_soc(dev, &axp2101_soc); // 读电量   2
+            return axp2101_soc;
+
+        case AXP2101_BATTERY_IOCTL_GET_POWERON_STATUS:   //  上电原因 3
+            axp2101_get_poweron_status(dev,&poweron_status);
+            return poweron_status;
+
+        case AXP2101_BATTERY_IOCTL_GET_POWEROFF_STATUS:  // 下电原因 4
+            axp2101_get_poweroff_status(dev,&poweroff_status);
+            return poweroff_status;
+
+        case AXP2101_BATTERY_IOCTL_GET_PMU_STATUS:   //  电源状态 5
+            axp2101_get_power_status(dev,&pmu_status);
+            return pmu_status;
+
+        case AXP2101_BATTERY_IOCTL_GET_PMU_CHARGE_STATUS: //  电源充电状态 6
+            axp2101_get_power_charge_status(dev, &pmu_charge_status);
+            return pmu_charge_status;
+
+        default:
+            return -ENOSYS;
+    }
+}
+
+static int axp2101_poweron_level(uint8_t poweron_level)
+{
+    switch (poweron_level)
+    {
+    case AXP2101_POWERON_LEVEL_0: return AXP2101_POWERON_TIME_0;
+    case AXP2101_POWERON_LEVEL_1: return AXP2101_POWERON_TIME_1;
+    case AXP2101_POWERON_LEVEL_2: return AXP2101_POWERON_TIME_2;
+    case AXP2101_POWERON_LEVEL_3: return AXP2101_POWERON_TIME_3;
+    default: 
+        return AXP2101_POWERON_TIME_3;
+    }
+}
+
+static int axp2101_poweroff_level(uint8_t poweroff_level)
+{
+    switch (poweroff_level)
+    {
+    case AXP2101_POWEROFF_LEVEL_0: return AXP2101_POWEROFF_TIME_0;
+    case AXP2101_POWEROFF_LEVEL_1: return AXP2101_POWEROFF_TIME_1;
+    case AXP2101_POWEROFF_LEVEL_2: return AXP2101_POWEROFF_TIME_2;
+    case AXP2101_POWEROFF_LEVEL_3: return AXP2101_POWEROFF_TIME_3;
+    default: 
+        return AXP2101_POWEROFF_TIME_1;
+    }
+}
+
+static int axp2101_set_poweron_level(FAR struct axp2101_dev_s *priv, uint8_t poweron_level)
+{
+  int     ret;
+  uint8_t val;
+  uint8_t power_on_time;
+  
+  ret = axp2101_getreg8(priv, AXP2101_IRQLEVEL_OFFLEVEL_ONLEVEL_SETTING, &val);
+  if(ret != OK)
+  {
+      return ret;
+  }
+
+  power_on_time = axp2101_poweron_level(poweron_level);
+  val &= ~(power_on_time);
+  val |= power_on_time;
+  axp2101_putreg8(priv, AXP2101_IRQLEVEL_OFFLEVEL_ONLEVEL_SETTING, val);
+
+  return OK;
+}
+
+static int axp2101_set_poweroff_level(FAR struct axp2101_dev_s *priv, uint8_t poweroff_level)
+{
+  int     ret;
+  uint8_t val;
+  uint8_t power_off_time;
+
+  ret = axp2101_getreg8(priv, AXP2101_IRQLEVEL_OFFLEVEL_ONLEVEL_SETTING, &val);
+  if(ret != OK)
+  {
+      return ret;
+  }
+
+  power_off_time = axp2101_poweroff_level(poweroff_level);
+  val &= ~(power_off_time << 2);
+  val |= (power_off_time << 2);
+  axp2101_putreg8(priv, AXP2101_IRQLEVEL_OFFLEVEL_ONLEVEL_SETTING, val);
+
+  return OK;
+}
+
