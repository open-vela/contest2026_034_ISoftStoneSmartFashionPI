+#define PCF85063_I2C_ADDRESS 0x51
+
+/* Control and status registers */
+
+#define PCF85063_REG_CONTROL1       0x00
+#  define PCF85063_CONTROL1_STOP     (1 << 5)
+#  define PCF85063_CONTROL1_12_24    (1 << 2)
+
+#define PCF85063_REG_CONTROL2       0x01
+#  define PCF85063_CONTROL2_AIE      (1 << 7)
+#  define PCF85063_CONTROL2_AF       (1 << 6)
+
+#define PCF85063_REG_OFFSET         0x02
+#define PCF85063_REG_RAM_BYTE       0x03
+
+/* Time and date registers */
+
+#define PCF85063_REG_SECONDS        0x04
+#  define PCF85063_SECONDS_OS       (1 << 7)
+#  define PCF85063_SECONDS_MASK     0x7f
+
+#define PCF85063_REG_MINUTES        0x05
+#  define PCF85063_MINUTES_MASK     0x7f
+
+#define PCF85063_REG_HOURS          0x06
+#  define PCF85063_HOURS_12_MASK    0x1f
+#  define PCF85063_HOURS_24_MASK    0x3f
+#  define PCF85063_HOURS_AMPM       (1 << 5)
+#  define PCF85063_HOURS_12_24      (1 << 6)
+
+#define PCF85063_REG_DAYS           0x07
+#  define PCF85063_DAYS_MASK        0x3f
+
+#define PCF85063_REG_WEEKDAYS       0x08
+#  define PCF85063_WEEKDAYS_MASK    0x07
+
+#define PCF85063_REG_MONTHS         0x09
+#  define PCF85063_MONTHS_MASK      0x1f
+
+#define PCF85063_REG_YEARS          0x0a
+
+/* Alarm registers */
+
+#define PCF85063_REG_SECOND_ALARM   0x0b
+#  define PCF85063_ALARM_AEN_S      (1 << 7)
+
+#define PCF85063_REG_MINUTE_ALARM   0x0c
+#  define PCF85063_ALARM_AEN_M      (1 << 7)
+
+#define PCF85063_REG_HOUR_ALARM     0x0d
+#  define PCF85063_ALARM_AEN_H      (1 << 7)
+
+#define PCF85063_REG_DAY_ALARM      0x0e
+#  define PCF85063_ALARM_AEN_D      (1 << 7)
+
+#define PCF85063_REG_WEEKDAY_ALARM  0x0f
+#  define PCF85063_ALARM_AEN_W      (1 << 7)
+
+/* Timer registers */
+
+#define PCF85063_REG_TIMER_VALUE    0x10
+#define PCF85063_REG_TIMER_MODE     0x11
+
+/****************************************************************************
+ * Public Types
+ ****************************************************************************/
+
+struct pcf85063_lowerhalf_s
+{
+  const struct rtc_ops_s *ops;
+  FAR struct i2c_master_s *i2c;
+  bool initialized;
+};
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+int pcf85063_rtc_initialize(FAR struct i2c_master_s *i2c);
+
