+
+#include "es7210.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* MCLK/LRCK ratio.  ES7210 datasheet Table "Erta Coefficient Table"
+ * lists supported ratios: 256, 384, 512, 768, 1024, 1536.
+ * 256xFS is the most common setting (e.g. 48kHz → MCLK=12.288MHz).
+ * Also used by ESP-IDF es7210 component (es7210.c MCLK_DIV_FRE).
+ */
+
+#define ES7210_MCLK_MULTIPLE    256
+
+/****************************************************************************
+ * Private Function Prototypes
+ ****************************************************************************/
+
+static int  es7210_getcaps(FAR struct audio_lowerhalf_s *dev, int type,
+                           FAR struct audio_caps_s *caps);
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+static int  es7210_configure(FAR struct audio_lowerhalf_s *dev,
+                             FAR void *session,
+                             FAR const struct audio_caps_s *caps);
+#else
+static int  es7210_configure(FAR struct audio_lowerhalf_s *dev,
+                             FAR const struct audio_caps_s *caps);
+#endif
+static int  es7210_shutdown(FAR struct audio_lowerhalf_s *dev);
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+static int  es7210_start(FAR struct audio_lowerhalf_s *dev,
+                         FAR void *session);
+#else
+static int  es7210_start(FAR struct audio_lowerhalf_s *dev);
+#endif
+
+#ifndef CONFIG_AUDIO_EXCLUDE_STOP
+#  ifdef CONFIG_AUDIO_MULTI_SESSION
+static int  es7210_stop(FAR struct audio_lowerhalf_s *dev,
+                        FAR void *session);
+#  else
+static int  es7210_stop(FAR struct audio_lowerhalf_s *dev);
+#  endif
+#endif
+
+#ifndef CONFIG_AUDIO_EXCLUDE_PAUSE_RESUME
+#  ifdef CONFIG_AUDIO_MULTI_SESSION
+static int  es7210_pause(FAR struct audio_lowerhalf_s *dev,
+                         FAR void *session);
+static int  es7210_resume(FAR struct audio_lowerhalf_s *dev,
+                          FAR void *session);
+#  else
+static int  es7210_pause(FAR struct audio_lowerhalf_s *dev);
+static int  es7210_resume(FAR struct audio_lowerhalf_s *dev);
+#  endif
+#endif
+
+static int  es7210_enqueuebuffer(FAR struct audio_lowerhalf_s *dev,
+                                 FAR struct ap_buffer_s *apb);
+static int  es7210_cancelbuffer(FAR struct audio_lowerhalf_s *dev,
+                                FAR struct ap_buffer_s *apb);
+static int  es7210_ioctl(FAR struct audio_lowerhalf_s *dev, int cmd,
+                         unsigned long arg);
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+static int  es7210_reserve(FAR struct audio_lowerhalf_s *dev,
+                           FAR void **session);
+static int  es7210_release(FAR struct audio_lowerhalf_s *dev,
+                           FAR void *session);
+#else
+static int  es7210_reserve(FAR struct audio_lowerhalf_s *dev);
+static int  es7210_release(FAR struct audio_lowerhalf_s *dev);
+#endif
+
+static void  es7210_processbegin(FAR struct es7210_dev_s *priv);
+static void  es7210_processdone(FAR struct i2s_dev_s *i2s,
+                                FAR struct ap_buffer_s *apb,
+                                FAR void *arg, int result);
+static void  es7210_worker(FAR void *arg);
+static void  es7210_returnbuffers(FAR struct es7210_dev_s *priv);
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static const struct audio_ops_s g_audioops =
+{
+  .getcaps       = es7210_getcaps,
+  .configure     = es7210_configure,
+  .shutdown      = es7210_shutdown,
+  .start         = es7210_start,
+#ifndef CONFIG_AUDIO_EXCLUDE_STOP
+  .stop          = es7210_stop,
+#endif
+#ifndef CONFIG_AUDIO_EXCLUDE_PAUSE_RESUME
+  .pause         = es7210_pause,
+  .resume        = es7210_resume,
+#endif
+  .enqueuebuffer = es7210_enqueuebuffer,
+  .cancelbuffer  = es7210_cancelbuffer,
+  .ioctl         = es7210_ioctl,
+  .reserve       = es7210_reserve,
+  .release       = es7210_release,
+};
+
+static FAR struct es7210_dev_s *g_es7210_priv = NULL;
+static bool g_es7210_mic_muted = false;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: es7210_writereg
+ ****************************************************************************/
+
+int es7210_writereg(FAR struct es7210_dev_s *priv, uint8_t regaddr,
+                       uint8_t regval)
+{
+  struct i2c_msg_s msg;
+  uint8_t txbuffer[2];
+  int ret;
+
+  txbuffer[0] = regaddr;
+  txbuffer[1] = regval;
+
+  msg.frequency = priv->lower.frequency;
+  msg.addr      = priv->lower.address;
+  msg.flags     = 0;
+  msg.buffer    = txbuffer;
+  msg.length    = 2;
+
+  ret = I2C_TRANSFER(priv->i2c, &msg, 1);
+  if (ret < 0)
+    {
+      auderr("ERROR: I2C_TRANSFER reg=0x%02x failed: %d\n", regaddr, ret);
+    }
+
+  return ret;
+}
+
+/****************************************************************************
+ * Name: es7210_readreg
+ ****************************************************************************/
+
+int es7210_readreg(FAR struct es7210_dev_s *priv, uint8_t regaddr,
+                       FAR uint8_t *regval)
+{
+  struct i2c_msg_s msg[2];
+  int ret;
+
+  /* Write register address */
+
+  msg[0].frequency = priv->lower.frequency;
+  msg[0].addr      = priv->lower.address;
+  msg[0].flags     = 0;
+  msg[0].buffer    = &regaddr;
+  msg[0].length    = 1;
+
+  /* Read register value */
+
+  msg[1].frequency = priv->lower.frequency;
+  msg[1].addr      = priv->lower.address;
+  msg[1].flags     = I2C_M_READ;
+  msg[1].buffer    = regval;
+  msg[1].length    = 1;
+
+  ret = I2C_TRANSFER(priv->i2c, msg, 2);
+  if (ret < 0)
+    {
+      auderr("ERROR: I2C_TRANSFER read reg=0x%02x failed: %d\n",
+             regaddr, ret);
+    }
+
+  return ret;
+}
+
+/****************************************************************************
+ * Name: es7210_reset
+ ****************************************************************************/
+
+static int es7210_reset(FAR struct es7210_dev_s *priv)
+{
+  uint32_t mclk_freq;
+  uint16_t lrck_div;
+
+  audinfo("ES7210 reset\n");
+
+  /* Query actual MCLK from I2S to compute correct LRCK divider.
+   * The I2S driver selects MCLK multiple (128/256/384/512) based on
+   * what divides cleanly into both sample rate and bit clock.
+   * ES7210's LRCK divider must match the actual MCLK / FS ratio.
+   */
+
+  mclk_freq = I2S_GETMCLKFREQUENCY(priv->i2s);
+  if (mclk_freq == 0 || priv->samprate == 0)
+    {
+      lrck_div = ES7210_MCLK_MULTIPLE;
+      audinfo("ES7210: MCLK=%lu rate=%u, fallback lrck_div=%u\n",
+              (unsigned long)mclk_freq, priv->samprate, lrck_div);
+    }
+  else
+    {
+      lrck_div = mclk_freq / priv->samprate;
+      audinfo("ES7210: MCLK=%lu rate=%u, computed lrck_div=%u\n",
+              (unsigned long)mclk_freq, priv->samprate, lrck_div);
+    }
+
+  /* Software reset: match ESP-IDF es7210_open() sequence */
+
+  es7210_writereg(priv, ES7210_RESET_REG00, 0xFF);
+  es7210_writereg(priv, ES7210_RESET_REG00, 0x41);
+
+  /* Clock off: disable all clocks first (ESP-IDF: REG01 = 0x3F) */
+
+  es7210_writereg(priv, ES7210_CLK_ON_REG01, 0x3F);
+
+  /* Set the initialization time when device powers up */
+
+  es7210_writereg(priv, ES7210_TCT0_CHPINI_REG09, 0x30);
+  es7210_writereg(priv, ES7210_TCT1_CHPINI_REG0A, 0x30);
+
+  /* Configure HPF for ADC1-4 (ESP-IDF register mapping order) */
+
+  es7210_writereg(priv, ES7210_ADC4_HPF_REG23, 0x2a);  /* ADC12_HPF2 */
+  es7210_writereg(priv, ES7210_ADC3_HPF_REG22, 0x0a);  /* ADC12_HPF1 */
+  es7210_writereg(priv, ES7210_ADC1_HPF_REG20, 0x0a);  /* ADC34_HPF2 */
+  es7210_writereg(priv, ES7210_ADC2_HPF_REG21, 0x2a);  /* ADC34_HPF1 */
+
+  /* Set slave mode: only clear bit0, preserve bit4 (channel mode).
+   * ESP-IDF uses update_reg_bit(REG08, 0x01, 0x00) which only touches bit0.
+   * Default REG08=0x10, bit4=1 means normal 2-ch output per data line.
+   * Writing 0x00 clears bit4 which may put ES7210 in 4-ch TDM mode,
+   * causing data density mismatch with 2-channel I2S master.
+   */
+  es7210_writereg(priv, ES7210_MODE_CFG_REG08, 0x10);
+
+  /* Set SDP: I2S format, 16-bit, Normal I2S (2-channel).
+   * REG11=0x60: I2S format, 16-bit word length
+   * REG12=0x00: Normal I2S mode (2-channel, L=ADC1, R=ADC2)
+   * This matches ESP-IDF board config which uses STD mode with 2 slots.
+   */
+
+  es7210_writereg(priv, ES7210_SDP_CFG1_REG11, ES7210_SDP_I2S_16BIT);
+  es7210_writereg(priv, ES7210_SDP_CFG2_REG12, ES7210_SDP_NORMAL);
+
+  /* Configure analog power: VDDA=3.3V, VMID select 5KΩ (ESP-IDF: 0x43) */
+
+  es7210_writereg(priv, ES7210_ANALOG_SYS_REG40, ES7210_VMID_SELECT);
+
+  /* Set MIC bias to 2.87V */
+
+  es7210_writereg(priv, ES7210_MICBIAS12_REG41, ES7210_MICBIAS_2V87);
+  es7210_writereg(priv, ES7210_MICBIAS34_REG42, ES7210_MICBIAS_2V87);
+
+  /* Set OSR */
+
+  es7210_writereg(priv, ES7210_ADC_OSR_REG07, 0x20);
+
+  /* ESP-IDF es7210_open() writes REG02=0xC1 UNCONDITIONALLY, even in
+   * slave mode. This enables DLL + Doubler + ADC_DIV=1, which is needed
+   * for the internal ADC clock chain to work properly.
+   * Without this, REG02 stays at default 0x02 and the ADC runs at wrong
+   * rate causing 1/8 data density.
+   *
+   * Note: LRCK_DIV (REG04/05) is NOT written in slave mode per ESP-IDF
+   * es7210_config_sample() which returns early for slave.
+   */
+
+  /* DLL/Doubler enabled: MCLK from pad with DLL + Doubler (ESP-IDF: 0xC1) */
+  es7210_writereg(priv, ES7210_MCLK_CTL_REG02, 0xC1);
+
+  /* MIC select: MIC1 + MIC2, matching ESP-IDF es7210_open() + es7210_mic_select().
+   *
+   * ESP-IDF es7210_mic_select() uses update_reg_bit:
+   *   MIC1: es7210_update_reg_bit(REG01, 0x0b, 0x00) → clear bits 0,1,3
+   *   MIC2: es7210_update_reg_bit(REG01, 0x0b, 0x00) → clear bits 0,1,3
+   *
+   * REG01 (CLOCK_OFF) bit map (active-low: 1=off, 0=on):
+   *   bit0 = MIC1_CLK, bit1 = MIC2_CLK, bit2 = MIC3_CLK, bit3 = ADC1_CLK,
+   *   bit4 = MICBIAS12, bit5 = MICBIAS34
+   *
+   * 0x0b = bit0(MIC1_CLK) + bit1(MIC2_CLK) + bit3(ADC1_CLK)
+   * Clearing these bits enables MIC1, MIC2, and ADC1 clocks.
+   */
+
+  /* Step 1: Power down all MICs first */
+  es7210_writereg(priv, ES7210_MIC12_POWER_REG4B, 0xFF);
+  es7210_writereg(priv, ES7210_MIC34_POWER_REG4C, 0xFF);
+
+  /* Step 2: Enable MIC1/MIC2 clocks, ADC1 clock, and MICBIAS12.
+   * REG01 bit map (active-low: 1=off, 0=on):
+   *   bit0 = MIC1_CLK, bit1 = MIC2_CLK, bit2 = MIC3_CLK,
+   *   bit3 = ADC1_CLK, bit4 = MICBIAS12, bit5 = MICBIAS34
+   * 0x1B = bit0+bit1+bit3+bit4. Clearing enables MIC1, MIC2, ADC1
+   * clocks AND MICBIAS12 (microphone bias voltage).
+   * Without MICBIAS12 enabled, microphones get no bias voltage
+   * and the ADC outputs a constant DC offset (0xea80).
+   * ESP-IDF uses 0x15 (bits 0,2,4) for 2-mic mode which also
+   * enables MICBIAS12.
+   */
+  {
+    uint8_t reg01;
+    es7210_readreg(priv, ES7210_CLK_ON_REG01, &reg01);
+    reg01 &= ~0x1B;  /* Clear bits 0,1,3,4 - disable ADC34/MIC34/BIAS34 clocks */
+    es7210_writereg(priv, ES7210_CLK_ON_REG01, reg01);
+  }
+  es7210_writereg(priv, ES7210_MIC12_POWER_REG4B, 0x00);
+  /* Keep MIC34 power off */
+
+  /* Step 3: Enable MIC1/MIC2 PGA and set gain */
+  es7210_writereg(priv, ES7210_ADC1_GAIN_REG43,
+                  ES7210_MIC_GAIN_30DB | ES7210_ADC_PGA_POWER_ON);
+  es7210_writereg(priv, ES7210_ADC2_GAIN_REG44,
+                  ES7210_MIC_GAIN_30DB | ES7210_ADC_PGA_POWER_ON);
+
+  /* Step 4: Write SDP2 (Normal I2S mode)
+   * REG12 = 0x00: Normal I2S (2-channel, L=ADC1, R=ADC2)
+   */
+  es7210_writereg(priv, ES7210_SDP_CFG2_REG12, ES7210_SDP_NORMAL);
+
+  /* Step 5: Power on MIC1/MIC2 only.
+   * REG47 = MIC1 power/mute, REG48 = MIC2 power/mute
+   * 0x08 = unmute, power on individual MIC
+   */
+  /* REG47 = MIC1_POWER, REG48 = MIC2_POWER (per ESP-IDF naming).
+   * ESP-IDF es7210_start() sets all REG47-4A to 0x08 (power on).
+   * 0x08 = unmute + power on for individual MIC channel.
+   */
+
+  es7210_writereg(priv, ES7210_ADC12_MUTE_REG47, 0x08);  /* MIC1 power on */
+  es7210_writereg(priv, ES7210_ADC34_MUTE_REG48, 0x08);  /* MIC2 power on */
+
+  /* Power on all digital blocks (ESP-IDF: REG06 = 0x00) */
+  es7210_writereg(priv, ES7210_DIGITAL_PDN_REG06, ES7210_POWER_ALL_ON);
+
+  /* Re-apply analog (ESP-IDF es7210_start does this) */
+  es7210_writereg(priv, ES7210_ANALOG_SYS_REG40, ES7210_VMID_SELECT);
+
+  /* Step 8: Enable device: clock off → device on (ESP-IDF: 0x71 → 0x41) */
+  es7210_writereg(priv, ES7210_RESET_REG00, 0x71);
+  es7210_writereg(priv, ES7210_RESET_REG00, 0x41);
+
+  /* Step 9: Explicitly unmute ADC digital output (REG14/REG15 bits[1:0]).
+   * The ESP-IDF driver explicitly clears these bits after init.
+   * Although reset defaults should be unmuted, some chips may
+   * have non-standard defaults or the mute may stick after reset.
+   */
+  {
+    uint8_t regval;
+    es7210_readreg(priv, 0x14, &regval);
+    regval &= ~0x03;
+    es7210_writereg(priv, 0x14, regval);
+    es7210_readreg(priv, 0x15, &regval);
+    regval &= ~0x03;
+    es7210_writereg(priv, 0x15, regval);
+  }
+
+  /* Step 10: Disable ADC automute (REG13).
+   * Some ES7210 revisions have automute enabled by default,
+   * which can cause silence when input levels are low.
+   */
+  es7210_writereg(priv, 0x13, 0x00);
+
+  /* Re-apply mic mute if set (es7210_reset overwrites all registers,
+   * so we must restore the mute state after initialization).
+   */
+
+  if (g_es7210_mic_muted)
+    {
+      es7210_writereg(priv, ES7210_MICBIAS12_REG41, 0x00);
+      es7210_writereg(priv, ES7210_ADC12_MUTE_REG47, 0x03);
+      es7210_writereg(priv, ES7210_ADC34_MUTE_REG48, 0x03);
+      uint8_t dmutereg;
+      es7210_readreg(priv, 0x14, &dmutereg);
+      dmutereg |= 0x03;
+      es7210_writereg(priv, 0x14, dmutereg);
+      es7210_readreg(priv, 0x15, &dmutereg);
+      dmutereg |= 0x03;
+      es7210_writereg(priv, 0x15, dmutereg);
+      printf("ES7210: mic mute re-applied after reset\n");
+    }
+
+  audinfo("ES7210 reset done\n");
+  return OK;
+}
+
+/****************************************************************************
+ * Name: es7210_getcaps
+ ****************************************************************************/
+
+static int es7210_getcaps(FAR struct audio_lowerhalf_s *dev, int type,
+                          FAR struct audio_caps_s *caps)
+{
+  /* Validate the structure */
+
+  DEBUGASSERT(caps && caps->ac_len >= sizeof(struct audio_caps_s));
+  audinfo("type=%d ac_type=%d\n", type, caps->ac_type);
+
+  /* Fill in the caller's structure based on requested info */
+
+  caps->ac_format.hw  = 0;
+  caps->ac_controls.w = 0;
+
+  switch (caps->ac_type)
+    {
+      case AUDIO_TYPE_QUERY:
+        caps->ac_channels = 2;
+
+        switch (caps->ac_subtype)
+          {
+            case AUDIO_TYPE_QUERY:
+              caps->ac_controls.b[0] = AUDIO_TYPE_INPUT;
+              caps->ac_format.hw     = (1 << (AUDIO_FMT_PCM - 1));
+              break;
+
+            default:
+              caps->ac_controls.b[0] = AUDIO_SUBFMT_END;
+              break;
+          }
+        break;
+
+      case AUDIO_TYPE_INPUT:
+        caps->ac_channels = 2;
+
+        switch (caps->ac_subtype)
+          {
+            case AUDIO_TYPE_QUERY:
+
+              /* Report supported sample rates */
+
+              caps->ac_controls.hw[0] = AUDIO_SAMP_RATE_8K  |
+                                        AUDIO_SAMP_RATE_16K |
+                                        AUDIO_SAMP_RATE_32K |
+                                        AUDIO_SAMP_RATE_48K;
+              break;
+
+            default:
+              break;
+          }
+        break;
+
+      case AUDIO_TYPE_PROCESSING:
+        break;
+
+      default:
+        break;
+    }
+
+  return caps->ac_len;
+}
+
+/****************************************************************************
+ * Name: es7210_configure
+ ****************************************************************************/
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+static int es7210_configure(FAR struct audio_lowerhalf_s *dev,
+                            FAR void *session,
+                            FAR const struct audio_caps_s *caps)
+#else
+static int es7210_configure(FAR struct audio_lowerhalf_s *dev,
+                            FAR const struct audio_caps_s *caps)
+#endif
+{
+  FAR struct es7210_dev_s *priv = (FAR struct es7210_dev_s *)dev;
+  int ret = OK;
+
+  DEBUGASSERT(priv != NULL && caps != NULL);
+  audinfo("ac_type: %d\n", caps->ac_type);
+
+  switch (caps->ac_type)
+    {
+      case AUDIO_TYPE_INPUT:
+        {
+          audinfo("  AUDIO_TYPE_INPUT:\n");
+          audinfo("    Number of channels: %u\n", caps->ac_channels);
+          audinfo("    Sample rate:        %u\n", caps->ac_controls.hw[0]);
+          audinfo("    Sample width:       %u\n", caps->ac_controls.b[2]);
+
+          /* Save current stream configuration */
+
+          if (caps->ac_channels > 0 && caps->ac_channels <= 2)
+            {
+              priv->nchannels = caps->ac_channels;
+            }
+
+          if (caps->ac_controls.hw[0] > 0)
+            {
+              priv->samprate = caps->ac_controls.hw[0];
+            }
+
+          /* Save current stream configuration - actual I2S setup is
+           * deferred to es7210_start() to avoid starting the I2S RX
+           * channel without DMA buffers (which causes interrupt storm).
+           */
+
+          if (caps->ac_controls.b[2] == 16 || caps->ac_controls.b[2] == 32)
+            {
+              priv->bpsamp = caps->ac_controls.b[2];
+            }
+        }
+        break;
+
+      case AUDIO_TYPE_PROCESSING:
+        break;
+
+      default:
+        break;
+    }
+
+  return ret;
+}
+
+/****************************************************************************
+ * Name: es7210_shutdown
+ ****************************************************************************/
+
+static int es7210_shutdown(FAR struct audio_lowerhalf_s *dev)
+{
+  audinfo("ES7210 shutdown\n");
+
+  /* Do nothing here. The nxrecorder "device" command triggers
+   * open→shutdown→close just to probe capabilities. Any I2C
+   * writes here could leave the chip in a state that causes
+   * problems during the subsequent es7210_reset() in start().
+   * The full reset in es7210_start() handles all initialization.
+   */
+
+  return OK;
+}
+
+/****************************************************************************
+ * Name: es7210_processbegin
+ ****************************************************************************/
+
+static void es7210_processbegin(FAR struct es7210_dev_s *priv)
+{
+  FAR struct ap_buffer_s *apb;
+
+  /* Do not start a new transfer if we are no longer running.
+   * es7210_start may call us after es7210_stop has already run
+   * (race with the 50 ms codec stabilization sleep).
+   */
+
+  if (!priv->running)
+    {
+      priv->inflight = false;
+      return;
+    }
+
+  /* Submit ALL pending buffers to the I2S layer at once.  The I2S
+   * driver queues them internally: the first buffer starts DMA,
+   * subsequent buffers are placed on the pend queue and picked up
+   * automatically when the previous transfer completes (in
+   * i2s_rx_worker).  This avoids the costly I2S stop/start cycle
+   * between every single buffer that was causing device freezes.
+   */
+
+  apb = (FAR struct ap_buffer_s *)dq_remfirst(&priv->pendq);
+  if (apb == NULL)
+    {
+      priv->inflight = false;
+      return;
+    }
+
+  priv->inflight = true;
+
+  while (apb != NULL)
+    {
+      I2S_RECEIVE(priv->i2s, apb, es7210_processdone, priv, 0);
+      apb = (FAR struct ap_buffer_s *)dq_remfirst(&priv->pendq);
+    }
+}
+
+/****************************************************************************
+ * Name: es7210_processdone
+ ****************************************************************************/
+
+static void es7210_processdone(FAR struct i2s_dev_s *i2s,
+                               FAR struct ap_buffer_s *apb,
+                               FAR void *arg, int result)
+{
+  FAR struct es7210_dev_s *priv = (FAR struct es7210_dev_s *)arg;
+  irqstate_t flags;
+
+  DEBUGASSERT(priv && apb);
+
+  audinfo("processdone: apb=%p nbytes=%u result=%d\n",
+         apb, apb->nbytes, result);
+
+  flags = enter_critical_section();
+
+  /* If we are no longer running, return buffer directly to upper half.
+   * We cannot just put it on pendq because es7210_stop/returnbuffers
+   * may have already run — the buffer would be leaked and nxrecorder
+   * would hang waiting for it.
+   */
+
+  if (!priv->running)
+    {
+      leave_critical_section(flags);
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+      priv->dev.upper(priv->dev.priv, AUDIO_CALLBACK_DEQUEUE,
+                      apb, -ENODATA, NULL);
+#else
+      priv->dev.upper(priv->dev.priv, AUDIO_CALLBACK_DEQUEUE,
+                      apb, -ENODATA);
+#endif
+      return;
+    }
+
+  /* Add the completed buffer to the done queue */
+
+  dq_addlast((FAR dq_entry_t *)apb, &priv->doneq);
+
+  leave_critical_section(flags);
+
+  /* Schedule LPWORK to return buffer and start next receive.
+   * Use 1-tick delay to prevent tight-looping when DMA completes
+   * faster than LPWORK can yield.
+   */
+
+  work_queue(LPWORK, &priv->work, es7210_worker, priv, 1);
+}
+
+/****************************************************************************
+ * Name: es7210_start
+ ****************************************************************************/
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+static int es7210_start(FAR struct audio_lowerhalf_s *dev,
+                        FAR void *session)
+#else
+static int es7210_start(FAR struct audio_lowerhalf_s *dev)
+#endif
+{
+  FAR struct es7210_dev_s *priv = (FAR struct es7210_dev_s *)dev;
+
+  audinfo("start\n");
+
+  priv->running = true;
+  priv->result  = OK;
+
+  /* Configure the I2S lower-half BEFORE resetting ES7210.
+   * This ensures the correct MCLK is set so that es7210_reset
+   * can compute the proper LRCK divider (lrck_div = MCLK / FS).
+   * I2S_RXSAMPLERATE sets up clocks and MCLK but does not start
+   * DMA; actual DMA only begins when I2S_RECEIVE submits buffers
+   * in es7210_processbegin below.
+   */
+
+  audinfo("ES7210 start: ch=%d bps=%d rate=%lu pendq_empty=%d\n",
+          priv->nchannels, priv->bpsamp, (unsigned long)priv->samprate,
+          dq_empty(&priv->pendq));
+
+  I2S_IOCTL(priv->i2s, AUDIOIOC_START, 0);
+  I2S_RXCHANNELS(priv->i2s, priv->nchannels);
+  I2S_RXDATAWIDTH(priv->i2s, priv->bpsamp);
+
+  /* ES7210 requires MCLK >= 256 * FS for proper ADC operation.
+   * The I2S driver may select MCLK multiple = 128 by default,
+   * which is too low for ES7210. Explicitly set MCLK to 256 * FS.
+   */
+
+  I2S_SETMCLKFREQUENCY(priv->i2s, (uint32_t)priv->samprate * 256);
+
+  /* Do NOT call I2S_RXSAMPLERATE before DMA buffers are submitted.
+   * With the fix in i2s_rxsamplerate(), it no longer starts the
+   * RX channel if it wasn't already started, so calling it here
+   * is safe — it only configures clocks without enabling DMA ints.
+   */
+
+  I2S_RXSAMPLERATE(priv->i2s, priv->samprate);
+
+  /* Reset the ES7210 hardware (now with correct MCLK for lrck_div) */
+
+  es7210_reset(priv);
+
+  /* Wait for the ES7210 codec to start outputting valid I2S data.
+   * After reset, the codec needs time to stabilize its clock.
+   * Note: use up_mdelay instead of nxsig_usleep because the audio
+   * framework calls start() with a semaphore held, which prevents
+   * signal-based sleep from completing.
+   */
+
+  up_mdelay(50);
+
+  /* DIAGNOSTIC: Dump key ES7210 registers after stabilization */
+  {
+    uint8_t r00, r01, r02, r03, r04, r05, r06, r07, r08;
+    uint8_t r11, r12, r13, r14, r15, r40, r47, r48, r4b;
+    es7210_readreg(priv, 0x00, &r00);
+    es7210_readreg(priv, 0x01, &r01);
+    es7210_readreg(priv, 0x02, &r02);
+    es7210_readreg(priv, 0x03, &r03);
+    es7210_readreg(priv, 0x04, &r04);
+    es7210_readreg(priv, 0x05, &r05);
+    es7210_readreg(priv, 0x06, &r06);
+    es7210_readreg(priv, 0x07, &r07);
+    es7210_readreg(priv, 0x08, &r08);
+    es7210_readreg(priv, 0x11, &r11);
+    es7210_readreg(priv, 0x12, &r12);
+    es7210_readreg(priv, 0x13, &r13);
+    es7210_readreg(priv, 0x14, &r14);
+    es7210_readreg(priv, 0x15, &r15);
+    es7210_readreg(priv, 0x40, &r40);
+    es7210_readreg(priv, 0x47, &r47);
+    es7210_readreg(priv, 0x48, &r48);
+    es7210_readreg(priv, 0x4b, &r4b);
+    /* printf("ES7210_REGS: R00=%02x R01=%02x R02=%02x R03=%02x "
+           "R04=%02x R05=%02x R06=%02x R07=%02x R08=%02x\n",
+           r00, r01, r02, r03, r04, r05, r06, r07, r08);
+    printf("ES7210_REGS: R11=%02x R12=%02x R13=%02x R14=%02x "
+           "R15=%02x R40=%02x R47=%02x R48=%02x R4B=%02x\n",
+           r11, r12, r13, r14, r15, r40, r47, r48, r4b); */
+  }
+
+  /* es7210_stop may have been called while we were sleeping.
+   * processbegin guards on running, but check here too so we
+   * avoid the I2S_RECEIVE call entirely.
+   */
+
+  if (!priv->running)
+    {
+      return OK;
+    }
+
+  /* Start initial receive operations */
+
+  es7210_processbegin(priv);
+
+  return OK;
+}
+
+#ifndef CONFIG_AUDIO_EXCLUDE_STOP
+
+/****************************************************************************
+ * Name: es7210_stop
+ ****************************************************************************/
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+static int es7210_stop(FAR struct audio_lowerhalf_s *dev,
+                       FAR void *session)
+#else
+static int es7210_stop(FAR struct audio_lowerhalf_s *dev)
+#endif
+{
+  FAR struct es7210_dev_s *priv = (FAR struct es7210_dev_s *)dev;
+
+  audinfo("stop\n");
+
+  priv->running  = false;
+  priv->inflight = false;  /* prevent enqueuebuffer from skipping processbegin */
+  work_cancel(LPWORK, &priv->work);
+
+  /* Tell I2S layer to stop streaming so DMA won't keep running */
+
+  I2S_IOCTL(priv->i2s, AUDIOIOC_STOP, 0);
+
+  /* Mute and power down */
+
+  es7210_writereg(priv, ES7210_ADC12_MUTE_REG47, ES7210_ADC_MUTE);
+  es7210_writereg(priv, ES7210_ADC34_MUTE_REG48, ES7210_ADC_MUTE);
+
+  /* Return any pending/done buffers */
+
+  es7210_returnbuffers(priv);
+
+  /* Notify upper half that we are done */
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+  priv->dev.upper(priv->dev.priv, AUDIO_CALLBACK_COMPLETE, NULL, OK, NULL);
+#else
+  priv->dev.upper(priv->dev.priv, AUDIO_CALLBACK_COMPLETE, NULL, OK);
+#endif
+
+  return OK;
+}
+
+#endif /* CONFIG_AUDIO_EXCLUDE_STOP */
+
+#ifndef CONFIG_AUDIO_EXCLUDE_PAUSE_RESUME
+
+/****************************************************************************
+ * Name: es7210_pause
+ ****************************************************************************/
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+static int es7210_pause(FAR struct audio_lowerhalf_s *dev,
+                        FAR void *session)
+#else
+static int es7210_pause(FAR struct audio_lowerhalf_s *dev)
+#endif
+{
+  FAR struct es7210_dev_s *priv = (FAR struct es7210_dev_s *)dev;
+
+  audinfo("ES7210 pause\n");
+  priv->paused = true;
+
+  /* Mute ADCs */
+
+  es7210_writereg(priv, ES7210_ADC12_MUTE_REG47, ES7210_ADC_MUTE);
+  es7210_writereg(priv, ES7210_ADC34_MUTE_REG48, ES7210_ADC_MUTE);
+
+  return OK;
+}
