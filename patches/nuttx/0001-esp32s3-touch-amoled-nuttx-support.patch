+static float axp2101_get_batt_voltage_internal(FAR struct axp2101_dev_s *priv)
+{
+  uint8_t hv, lv;
+  axp2101_getreg8(priv, AXP2101_BAT_VOLTAGE_H6, &hv);
+  axp2101_getreg8(priv, AXP2101_BAT_VOLTAGE_L8, &lv);
+  return ((hv << 8) | lv) * AXP2101_BATT_VOLTAGE_STEP;
+}
