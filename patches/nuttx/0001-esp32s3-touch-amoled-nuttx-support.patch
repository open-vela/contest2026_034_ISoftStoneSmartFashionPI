+#elif defined(CONFIG_CPP_HAVE_VARARGS)
+#  define _warn(format, ...) \
+   __arch_syslog(LOG_WARNING, EXTRA_FMT format EXTRA_ARG, ##__VA_ARGS__)
+#endif
