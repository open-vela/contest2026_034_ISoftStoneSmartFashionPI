+struct lcd_dev_s *co5300_amoledinitialize(struct qspi_dev_s *qspi)
+{
+  //printf("CO5300: board_lcd_initialize() started\n");
+
+  /* Configure RST GPIO */
+  esp32s3_configgpio(DISPLAY_RST_CO5300, OUTPUT);
+  esp32s3_gpiowrite(DISPLAY_RST_CO5300, true);
+
+  QSPI_SETMODE(qspi, QSPIDEV_MODE0);
+  QSPI_SETFREQUENCY(qspi, LCD_QSPI_FREQ);
+  esp32s3_qspibus_set_attr(qspi, 0, 1, 4);
+
+  /* Initialize LCD panel */
+  lcd_init(qspi);
+
+  memset(&g_co5300dev, 0, sizeof(g_co5300dev));
+  g_co5300dev.dev   = g_co5300_lcddev;
+  g_co5300dev.qspi  = qspi;
+  g_co5300dev.power = 1;
+
+#if TE_SYNC
+  /* Set up TE (Tearing Effect) vblank sync on GPIO13.  The panel was already
+   * told to output TE at vblank by init command 0x35 above.
+   */
+
+  nxsem_init(&g_co5300dev.te_sem, 0, 0);
+  nxsem_set_protocol(&g_co5300dev.te_sem, SEM_PRIO_NONE);
+
+  esp32s3_configgpio(DISPLAY_TE_CO5300, INPUT_PULLDOWN);
+  {
+    int te_irq = ESP32S3_PIN2IRQ(DISPLAY_TE_CO5300);
+    irq_attach(te_irq, co5300_te_isr, &g_co5300dev);
+    esp32s3_gpioirqenable(te_irq, TE_EDGE);
+  }
+#endif
+
+#if GAPFREE_STREAM
+  /* Allocate a full-frame, byte-swapped DMA source in PSRAM.  In this flat
+   * build malloc() draws from the PSRAM user heap (kmm_malloc() = internal).
+   * Streaming the whole frame from one prepared buffer keeps the QSPI output
+   * gap-free after TE, removing the chunk-boundary tearing.
+   */
+
+  g_frame_buf_size = (BSP_LCD_H_RES * BSP_LCD_V_RES * (BSP_LCD_BPP / 8)
+                      + 63) & ~63u;
+  g_frame_buf = memalign(64, g_frame_buf_size);
+  if (g_frame_buf != NULL)
+    {
+      g_frame_buf_extram = co5300_ptr_extram(g_frame_buf);
+      syslog(LOG_INFO, "CO5300: gap-free buf=%p size=%lu extram=%d\n",
+             g_frame_buf, (unsigned long)g_frame_buf_size,
+             (int)g_frame_buf_extram);
+    }
+  else
+    {
+      syslog(LOG_WARNING,
+             "CO5300: frame buf alloc failed; per-chunk swap fallback\n");
+    }
+#endif
+
+  //printf("CO5300: board_lcd_initialize() done\n");
+  
+  /* write window test*/
+  #if 0
+  test_amoled(&g_co5300dev);
+  test_amoled_big(&g_co5300dev);
+  #endif
+  syslog(LOG_INFO, "CO5300: Hardware initialization complete!\n");
+  return &g_co5300dev.dev;
+}
+
+int esp32s3_set_brightness(int level)
+{
+  if (level < 0 || level > 4)
+    {
+      printf("ERROR: Invalid brightness level %d\n", level);
+      return -EINVAL;
+    }
+  
+  return co5300_setcontrast(&g_co5300dev.dev, (unsigned int)level);
+}
+
+int esp32s3_get_brightness(void)
+{
+  return co5300_getcontrast(&g_co5300dev.dev);
+}
+
+void esp32s3_display_off(void)
+{
+  co5300_setpower(&g_co5300dev.dev, 0);
+}
+
+void esp32s3_display_on(void)
+{
+  co5300_setpower(&g_co5300dev.dev, 1);
+}
