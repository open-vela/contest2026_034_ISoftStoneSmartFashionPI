+
+#ifndef __INCLUDE_NUTTX_POWER_BATTERY_AXP2101_H
+#define __INCLUDE_NUTTX_POWER_BATTERY_AXP2101_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <nuttx/fs/ioctl.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define AXP2101_BATTERY_IOCTL_POWEROFF  (0)
+#define AXP2101_BATTERY_IOCTL_RESET     (1)
+#define AXP2101_BATTERY_IOCTL_GET_SOC   (2)
+#define AXP2101_BATTERY_IOCTL_GET_POWERON_STATUS        (3)
+#define AXP2101_BATTERY_IOCTL_GET_POWEROFF_STATUS       (4)
+#define AXP2101_BATTERY_IOCTL_GET_PMU_STATUS            (5)
+#define AXP2101_BATTERY_IOCTL_GET_PMU_CHARGE_STATUS     (6)
+
+/* 0x00 - STATUS1: PMU状态寄存器1
+  Bit 5: VBUS是否正常，Bit 4: BATFET状态，  Bit 3: 电池是否连接，
+  Bit 2: 电池是否处于活动模式，  Bit 1: 热调节状态，  Bit 0: 电流限制状态 */
+#define AXP2101_PMU_STATUS                           (0x00)
+
+/*  0x0 - STATUS2: PMU状态寄存器2
+  Bit [7:5]: 充电状态，000: 待机，001: 充电中，010: 放电
+  Bit 4: 电源开关状态
+  Bit 3: VBUS插入状态
+  Bit [2:0]: 充电器状态
+    000: 涓流充电
+    001: 预充电
+    010: 恒流充电
+    011: 恒压充电
+    100: 充电完成
+    101: 停止充电 */
+#define AXP2101_PMU_CHARGE_STATUS                   (0x01)
+/* 0x01 STATUS2 寄存器 Bit3 实测恒为0，不是 VBUS 插入位（2026-08-31 验证）。
+ * 「充电器是否插着」由 6:5 充电状态位推断：10=放电(未插)，01=充电中、
+ * 00=待机(充满停充，仅插着时出现) → 非放电即插着。见 axp2101_get_vbus_status() */
+#define AXP2101_VBUS_PRESENT_BIT                    (0x08)
+#define AXP2101_BATTERY_PERCENTAGE_DATA             (0XA4)
+
+/* 0x10 - COMMON_CONFIG: 通用配置
+  Bit 5: 内部放电使能
+  Bit 3: PWROK引脚下拉使能
+  Bit 2: PWRON关闭PMIC使能
+  Bit 1: 系统复位
+  Bit 0: 关机
+*/
+#define AXP2101_COMMON_CONFIGURE_CTL                  (0x10)
+
+#define AXP2101_MIN_SYSTEM_VOLTAGE_CONTROL            (0x14)
+#define AXP2101_INPUT_VOL_LIMIT_CTRL                  (0X15)     /* 输入电压限制控制 */
+#define AXP2101_INPUT_CUR_LIMIT_CTRL                  (0x16)     /* 输入电流限制控制 */
+
+
+#define AXP2101_POWER_ON_STATUS_REASON                (0x20) 
+#define AXP2101_POWER_OFF_STATUS_REASON               (0x21) 
+
+#define AXP2101_IRQLEVEL_OFFLEVEL_ONLEVEL_SETTING     (0X27) /*设置中断、下电，上电时间配置*/
+
+
+/* 电源路径与充电配置 */
+#define ADC_CHANNEL_CTRL          (0x30)    /* ADC通道控制 */
+// 0x34-0x3D - ADC_DATA_RELUST0-9: ADC数据结果寄存器
+// 0x40-0x42 - INTEN1-3: 中断使能寄存器
+// 0x48-0x4A - INTSTS1-3: 中断状态寄存器
+
+/* ADC数据结果寄存器 (AXP2101 datasheet: 14-bit, H6[5:0]+L8[7:0]) */
+#define AXP2101_BAT_VOLTAGE_H6         (0x34)
+#define AXP2101_BAT_VOLTAGE_L8         (0x35)
+#define AXP2101_TS_VOLTAGE_H6          (0x36)
+#define AXP2101_TS_VOLTAGE_L8          (0x37)
+#define AXP2101_VBUS_VOLTAGE_H6        (0x38)
+#define AXP2101_VBUS_VOLTAGE_L8        (0x39)
+#define AXP2101_VSYS_VOLTAGE_H6        (0x3A)
+#define AXP2101_VSYS_VOLTAGE_L8        (0x3B)
+#define AXP2101_DIE_TEMP_H6            (0x3C)
+#define AXP2101_DIE_TEMP_L8            (0x3D)
+
+/* AXP2101 ADC步进值 */
+#define AXP2101_BATT_VOLTAGE_STEP          (1.0F)
+#define AXP2101_VBUS_VOLTAGE_STEP          (1.0F)
+#define AXP2101_VSYS_VOLTAGE_STEP          (1.0F)
+#define AXP2101_TS_VOLTAGE_STEP            (0.5F)
+#define AXP2101_DIE_TEMP_STEP              (0.1F)
+
+#define IRQ_ENABLE_1                     (0x41)
+#define AXP2101_IRQ_STATUS_1             (0x49) 
+
+#define AXP2101_IPRECHG_SET              (0x61)         /* 预充电电流设置 */
+#define AXP2101_ICC_CHG_SET              (0x62)         /* 恒流充电电流设置 */
+#define AXP2101_ITERM_CHG_SET_CTRL       (0x63)         /* 充电终止电流设置与控制 */
+#define AXP2101_CV_CHG_VOL_SET           (0x64)         /* 充电目标电压设置 */
+
+#define AXP2101_DCDC1_OUT_ENABLE      (0X80)
+#define AXP2101_DCDC1_OUT_CTL      (0X82)
+#define AXP2101_DCDC2_OUT_CTL      (0X83)
+#define AXP2101_DCDC3_OUT_CTL      (0X84)
+#define AXP2101_DCDC4_OUT_CTL      (0X85)
+
+#define AXP2101_ABCDLDO_OUT_ENABLE      (0x90)
+#define AXP2101_DLDO_OUT_ENABLE         (0x91)
+#define AXP2101_ALDO1_OUT_CTL           (0x92)
+#define AXP2101_ALDO2_OUT_CTL           (0x93)
+#define AXP2101_ALDO3_OUT_CTL           (0x94)
+#define AXP2101_ALDO4_OUT_CTL           (0x95)
+#define AXP2101_BLDO1_OUT_CTL           (0x96)
+#define AXP2101_BLDO2_OUT_CTL           (0x97)
+#define AXP2101_CPUSLDO_OUT_CTL         (0x98)
+
+#define AXP2101_IC_TYPE  (0x03)
+#define AXP2101_CHIP_ID  (0x4A)
+
+
+#define AXP2101_POWERON_LEVEL      (3)
+#define AXP2101_POWEROFF_LEVEL     (1)
+
+typedef enum {
+    AXP2101_POWERON_LEVEL_0 = 0,    // 00:128ms
+    AXP2101_POWERON_LEVEL_1 = 1,    // 01:512ms
+    AXP2101_POWERON_LEVEL_2 = 2,    // 10:1s
+    AXP2101_POWERON_LEVEL_3 = 3,    // 11:2s
+} AXP2101_PowerOnLevel;
+
+typedef enum {
+    AXP2101_POWERON_TIME_0 = 0x00,     // 00:128ms
+    AXP2101_POWERON_TIME_1 = 0x01,     // 01:512ms
+    AXP2101_POWERON_TIME_2 = 0x02,     // 10:1s
+    AXP2101_POWERON_TIME_3 = 0x03,     // 11:2s
+} AXP2101_PowerOnTime;
+
+
+typedef enum {
+    AXP2101_POWEROFF_LEVEL_0 = 0,     // 00:4s
+    AXP2101_POWEROFF_LEVEL_1 = 1,     // 01:6s
+    AXP2101_POWEROFF_LEVEL_2 = 2,     // 10:8s
+    AXP2101_POWEROFF_LEVEL_3 = 3,     // 11:10s
+} AXP2101_PowerOffLevel;
+
+typedef enum {
+    AXP2101_POWEROFF_TIME_0 = 0X00,    // 00:4s
+    AXP2101_POWEROFF_TIME_1 = 0X01,    // 01:6s
+    AXP2101_POWEROFF_TIME_2 = 0X02,    // 10:8s
+    AXP2101_POWEROFF_TIME_3 = 0X03,    // 11:10s
+} AXP2101_PowerOffTime;
